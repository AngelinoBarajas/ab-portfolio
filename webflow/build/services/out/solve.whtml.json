 "css": ".section_sv-solve{position:relative}\n.ab_sv_solve{position:relative;z-index:3;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-row-gap:16px;grid-column-gap:16px}\n.ab_sv_s{position:relative;display:flex;flex-direction:column;overflow-x:hidden;overflow-y:hidden;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:rgba(14,16,32,0.62)}\n.ab_sv_s_pb{padding-top:20px;padding-right:22px;padding-bottom:18px;padding-left:22px;border-bottom-width:1px;border-bottom-style:dashed;border-bottom-color:var(--_color---neutral--hair-strong)}\n.ab_sv_s_k{display:flex;justify-content:space-between;color:var(--_color---text--tertiary);font-size:10.5px;letter-spacing:0.12em;text-transform:uppercase}\n.ab_sv_s_before{font-weight:500;color:#ff5a5a}\n.ab_sv_s_p{margin-top:10px;margin-bottom:0;color:var(--_color---text--secondary);font-size:17px;line-height:1.4}\n.ab_sv_s_fx{position:relative;display:flex;flex-grow:1;flex-shrink:1;flex-basis:0%;flex-direction:column;grid-row-gap:8px;grid-column-gap:8px;padding-top:18px;padding-right:22px;padding-bottom:22px;padding-left:22px}\n.ab_sv_s_fx-k{color:var(--_color---brand--signal);font-size:10.5px;letter-spacing:0.12em;text-transform:uppercase}\n.ab_sv_s_h{margin-top:0;margin-bottom:0;font-weight:800;font-stretch:112%;font-size:clamp(20px,1.7vw,24px);line-height:1.06;text-transform:uppercase}\n.ab_sv_s_a{margin-bottom:0;color:var(--_color---text--secondary);font-size:15.5px;line-height:1.55}\n@media screen and (max-width: 991px) {\n.ab_sv_solve{grid-template-columns:minmax(0,1fr)}\n}\n"
