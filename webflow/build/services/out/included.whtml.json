 "css": ".section_sv-included{position:relative}\n.ab_bento_grid.is-included{grid-auto-rows:minmax(190px,auto)}\n.ab_bento-card.is-sv{justify-content:space-between}\n.ab_sv_dl_n{display:flex;justify-content:space-between;align-items:center;color:var(--_color---text--tertiary);font-size:11px;letter-spacing:0.12em;text-transform:uppercase}\n.ab_sv_dl_ck{display:grid;align-items:center;justify-items:center;width:20px;height:20px;border-top-width:1.5px;border-top-style:solid;border-top-color:var(--_color---neutral--hair-strong);border-right-width:1.5px;border-right-style:solid;border-right-color:var(--_color---neutral--hair-strong);border-bottom-width:1.5px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair-strong);border-left-width:1.5px;border-left-style:solid;border-left-color:var(--_color---neutral--hair-strong)}\n.ab_sv_dl_ic{width:44px;height:44px;color:var(--_color---text--primary);opacity:0.8}\n"
