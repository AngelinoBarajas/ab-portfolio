{
 "html": "<section class=\"section_sv-plan\" id=\"plan\" data-frame=\"flight-plan\" aria-labelledby=\"plan-h\"><span class=\"ab_frame-label\" data-frame-label=\"\" aria-hidden=\"true\">▢ flight-plan</span><div class=\"padding-global\"><div class=\"container-large\"><div class=\"padding-section-medium\"><div class=\"ab_sec-h\"><div class=\"ab_section-head is-flush\"><div class=\"text-style-eyebrow\">/flight-plan · <span data-sv=\"plan-count\">4</span> stages</div><h2 class=\"heading-style-h2\" id=\"plan-h\" data-split=\"\">Flight <span class=\"t-outline\">plan</span></h2></div><p class=\"ab_sec-h_lede text-size-lede\">How this service usually runs, from first call to launch.</p></div><div class=\"ab_sv_plan\" id=\"svPlan\"><div class=\"ab_sv_plan_line\" aria-hidden=\"true\"></div><div class=\"ab_sv_plan_fill\" aria-hidden=\"true\"></div><div class=\"ab_sv_plan_item\" data-selectable=\"\" data-name=\"Card / stage-01\"><div class=\"ab_sv_plan_k text-style-mono\">Stage 01</div><h3 class=\"ab_sv_plan_h\" data-field=\"stage-1\">Stage</h3><p class=\"ab_sv_plan_p\" data-field=\"stage-1-desc\">What happens.</p></div><div class=\"ab_sv_plan_item\" data-selectable=\"\" data-name=\"Card / stage-02\"><div class=\"ab_sv_plan_k text-style-mono\">Stage 02</div><h3 class=\"ab_sv_plan_h\" data-field=\"stage-2\">Stage</h3><p class=\"ab_sv_plan_p\" data-field=\"stage-2-desc\">What happens.</p></div><div class=\"ab_sv_plan_item\" data-selectable=\"\" data-name=\"Card / stage-03\"><div class=\"ab_sv_plan_k text-style-mono\">Stage 03</div><h3 class=\"ab_sv_plan_h\" data-field=\"stage-3\">Stage</h3><p class=\"ab_sv_plan_p\" data-field=\"stage-3-desc\">What happens.</p></div><div class=\"ab_sv_plan_item\" data-selectable=\"\" data-name=\"Card / stage-04\"><div class=\"ab_sv_plan_k text-style-mono\">Stage 04</div><h3 class=\"ab_sv_plan_h\" data-field=\"stage-4\">Stage</h3><p class=\"ab_sv_plan_p\" data-field=\"stage-4-desc\">What happens.</p></div></div></div></div></div></section>",
 "css": ".section_sv-plan{position:relative}\n.ab_sv_plan{position:relative;z-index:3;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-row-gap:18px;grid-column-gap:18px;padding-top:34px}\n.ab_sv_plan_line{position:absolute;left:0;right:0;top:8px;height:2px;background-color:var(--_color---neutral--hair)}\n.ab_sv_plan_fill{position:absolute;left:0;top:8px;width:100%;height:2px;background-image:linear-gradient(90deg,#FF6A3D,#ffb08f)}\n.ab_sv_plan_item{position:relative;padding-top:20px;padding-right:20px;padding-bottom:22px;padding-left:20px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:rgba(14,16,32,0.62)}\n.ab_sv_plan_k{color:var(--_color---brand--signal);font-size:10.5px;letter-spacing:0.12em;text-transform:uppercase}\n.ab_sv_plan_h{margin-top:10px;margin-bottom:0;font-weight:800;font-stretch:112%;font-size:clamp(19px,1.6vw,23px);line-height:1.06;text-transform:uppercase}\n.ab_sv_plan_p{margin-top:8px;margin-bottom:0;color:var(--_color---text--secondary);font-size:15px;line-height:1.5}\n@media screen and (max-width: 991px) {\n.ab_sv_plan{grid-template-columns:repeat(2,minmax(0,1fr));grid-row-gap:52px}\n.ab_sv_plan_line{display:none}\n.ab_sv_plan_fill{display:none}\n}\n@media screen and (max-width: 479px) {\n.ab_sv_plan{grid-template-columns:minmax(0,1fr)}\n}\n"
}