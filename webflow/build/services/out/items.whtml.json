{
 "html": "<a class=\"ab_sv_pair\" href=\"#\"><p class=\"ab_sv_pair_name\" data-field=\"name\">Service</p></a><a class=\"ab_sv_rail_link\" href=\"#\"><span class=\"ab_sv_rail_dot\"></span><span class=\"ab_sv_rail_no\">01</span><p class=\"ab_sv_rail_name\" data-field=\"name\">Service</p></a>",
 "css": ".ab_sv_pair{display:inline-block;color:var(--_color---text--primary);text-decoration:none;transition:color 200ms ease}\n.ab_sv_pair:hover{color:var(--_color---brand--signal)}\n.ab_sv_pair_name{margin-top:0;margin-bottom:0;font-size:15px}\n.ab_sv_rail_link{position:relative;display:inline-flex;flex-grow:0;flex-shrink:0;flex-basis:auto;align-items:center;grid-row-gap:10px;grid-column-gap:10px;padding-top:9px;padding-right:14px;padding-bottom:9px;padding-left:10px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:rgba(14,16,32,0.55);color:var(--_color---text--secondary);font-size:11.5px;letter-spacing:0.06em;text-transform:uppercase;white-space:nowrap;text-decoration:none;transition:border-color 250ms ease,color 250ms ease,background-color 250ms ease}\n.ab_sv_rail_link:hover{border-top-color:var(--_color---neutral--hair-strong);border-right-color:var(--_color---neutral--hair-strong);border-bottom-color:var(--_color---neutral--hair-strong);border-left-color:var(--_color---neutral--hair-strong);color:var(--_color---text--primary)}\n.ab_sv_rail_dot{width:14px;height:14px;flex-grow:0;flex-shrink:0;flex-basis:auto;border-top-left-radius:50%;border-top-right-radius:50%;border-bottom-right-radius:50%;border-bottom-left-radius:50%;background-color:#8A8FA3}\n.ab_sv_rail_no{color:var(--_color---text--tertiary)}\n.ab_sv_rail_name{margin-top:0;margin-bottom:0}\n"
}