{
 "html": "<section class=\"section_arc-cta\" data-frame=\"next-mission\" aria-label=\"Start a project\"><span class=\"ab_frame-label\" data-frame-label=\"\" aria-hidden=\"true\">▢ next-mission</span><div class=\"padding-global\"><div class=\"container-large\"><div class=\"ab_arc-cta\"><a class=\"ab_next-card\" href=\"/#launch\" data-next-card=\"\"><div class=\"ab_next-card_content\"><div class=\"ab_next-card_eyebrow text-style-mono\">Mission 07 · unassigned</div><h2 class=\"ab_next-card_title\">Your mission<br>next?</h2><div class=\"ab_next-card_go\">Start a project <span aria-hidden=\"true\">→</span></div></div><div class=\"ab_planet is-next\" data-planet=\"rocky\" data-seed=\"77\" data-colors=\"#3b1f12,#a44a1f,#ff8a4c,#ffd29a\" data-spin=\"40\" data-glow=\"rgba(255,106,61,.35)\" aria-hidden=\"true\"></div></a></div></div></div></section>",
 "css": ".section_arc-cta{position:relative}\n.ab_arc-cta{position:relative;padding-top:64px;padding-bottom:clamp(64px,9vw,120px)}\n.ab_next-card{position:relative;z-index:3;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;grid-row-gap:24px;grid-column-gap:24px;padding-top:clamp(28px,5vw,60px);padding-right:clamp(28px,5vw,60px);padding-bottom:clamp(28px,5vw,60px);padding-left:clamp(28px,5vw,60px);border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:rgba(14,16,32,0.6);color:var(--_color---text--primary);text-decoration:none;overflow-x:hidden;overflow-y:hidden;isolation:isolate;transition:border-color 300ms ease}\n.ab_next-card:hover{border-top-color:var(--_color---brand--signal);border-right-color:var(--_color---brand--signal);border-bottom-color:var(--_color---brand--signal);border-left-color:var(--_color---brand--signal)}\n.ab_next-card_content{position:relative;z-index:3}\n.ab_next-card_eyebrow{color:var(--_color---text--tertiary);text-transform:uppercase;letter-spacing:0.12em}\n.ab_next-card_title{margin-top:14px;font-weight:900;font-stretch:118%;font-size:clamp(44px,8vw,130px);line-height:0.88;letter-spacing:-0.03em;text-transform:uppercase;transition:transform 500ms cubic-bezier(.2,.9,.2,1)}\n.ab_next-card_go{position:relative;display:inline-flex;align-items:center;grid-row-gap:10px;grid-column-gap:10px;margin-top:20px;padding-top:12px;padding-right:16px;padding-bottom:12px;padding-left:16px;border-top-width:1px;border-top-style:solid;border-top-color:rgba(255,106,61,0.4);border-right-width:1px;border-right-style:solid;border-right-color:rgba(255,106,61,0.4);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:rgba(255,106,61,0.4);border-left-width:1px;border-left-style:solid;border-left-color:rgba(255,106,61,0.4);color:var(--_color---brand--signal);font-size:13px;letter-spacing:0.1em;text-transform:uppercase;transition:background-color 250ms ease,color 250ms ease,border-color 250ms ease}\n.ab_planet.is-next{position:relative;z-index:3;width:clamp(90px,14vw,190px)}\n"
}