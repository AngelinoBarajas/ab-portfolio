{
 "html": "<div class=\"ab_mission-card\"><a class=\"ab_mission-card_link\" href=\"#\" data-card-link=\"\" data-selectable=\"\"><div class=\"ab_mission-card_cover\"><div class=\"ab_mission-card_cv\"></div><div class=\"ab_mission-card_no text-style-mono\">01</div><div class=\"ab_mission-card_ph text-style-mono\">Placeholder mission</div><div class=\"ab_planet is-card\" aria-hidden=\"true\"></div></div><div class=\"ab_mission-card_body\"><div class=\"ab_mission-card_top text-style-mono\"><div class=\"ab_mission-card_client\">Client</div><div class=\"ab_mission-card_year\">2026</div></div><h3 class=\"ab_mission-card_title\">Mission name</h3><p class=\"ab_mission-card_sum\">One-line mission summary.</p><div class=\"ab_mission-card_tags\" data-card-tags=\"\"></div><div class=\"ab_mission-card_foot\"><div class=\"ab_status\"><span class=\"ab_status_dot\"></span><div class=\"ab_status_label\">Shipped</div></div><div class=\"ab_mission-card_go text-style-mono\">Read debrief <span class=\"ab_mission-card_arrow\">→</span></div></div></div><div class=\"ab_cms-source\" aria-hidden=\"true\"><div data-field=\"brand-bg\"></div><div data-field=\"brand-fg\"></div><div data-field=\"brand-accent\"></div></div></a></div>",
 "css": ".ab_mission-card{position:relative;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:var(--_color---neutral--panel);transition:border-color 300ms ease,box-shadow 400ms ease}\n.ab_mission-card:hover{border-top-color:var(--_color---neutral--hair-strong);border-right-color:var(--_color---neutral--hair-strong);border-bottom-color:var(--_color---neutral--hair-strong);border-left-color:var(--_color---neutral--hair-strong);z-index:6}\n.ab_mission-card_link{display:flex;flex-direction:column;height:100%;min-width:0;color:inherit;text-decoration:none}\n.ab_mission-card_cover{position:relative;aspect-ratio:16/10;overflow-x:hidden;overflow-y:hidden;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);isolation:isolate}\n.ab_mission-card_cv{position:absolute;top:0;right:0;bottom:0;left:0;background-color:#161a2e;transition:transform 800ms cubic-bezier(.2,.9,.2,1)}\n.ab_mission-card_img{width:100%;height:100%;object-fit:cover;object-position:0% 0%;display:block}\n.ab_mission-card_no{position:absolute;left:12px;top:10px;z-index:2;padding-top:3px;padding-right:7px;padding-bottom:3px;padding-left:7px;background-color:rgba(7,8,13,0.78);color:var(--_color---text--primary);font-size:11px;letter-spacing:0.1em}\n.ab_mission-card_ph{position:absolute;right:0;top:14px;z-index:2;display:none;padding-top:4px;padding-right:10px;padding-bottom:4px;padding-left:10px;background-image:repeating-linear-gradient(-45deg,#FF6A3D 0px,#FF6A3D 8px,#07080D 8px,#07080D 16px);color:#fff;font-size:10px;letter-spacing:0.14em;text-transform:uppercase}\n.ab_planet.is-card{left:auto;top:auto;right:14px;bottom:-22%;width:24%;z-index:3;transition:bottom 600ms cubic-bezier(.2,.9,.2,1.2)}\n.ab_mission-card_body{position:relative;z-index:3;display:flex;flex-direction:column;grid-row-gap:10px;grid-column-gap:10px;flex-grow:1;flex-shrink:1;flex-basis:0%;min-width:0;padding-top:18px;padding-right:20px;padding-bottom:20px;padding-left:20px}\n.ab_mission-card_top{display:flex;justify-content:space-between;grid-row-gap:10px;grid-column-gap:10px;color:var(--_color---text--tertiary);font-size:10.5px;letter-spacing:0.08em;text-transform:uppercase}\n.ab_mission-card_client{white-space:nowrap;overflow-x:hidden;overflow-y:hidden;text-overflow:ellipsis}\n.ab_mission-card_title{font-weight:900;font-stretch:118%;font-size:clamp(22px,2vw,30px);line-height:0.95;letter-spacing:-0.01em;text-transform:uppercase}\n.ab_mission-card_sum{color:var(--_color---text--secondary);font-size:14.5px;line-height:1.5}\n.ab_mission-card_tags{display:flex;flex-wrap:wrap;grid-row-gap:5px;grid-column-gap:5px}\n.ab_mission-card_tag{padding-top:3px;padding-right:7px;padding-bottom:3px;padding-left:7px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair-strong);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair-strong);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair-strong);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair-strong);color:var(--_color---text--secondary);font-size:10.5px;letter-spacing:0.05em;text-transform:uppercase}\n.ab_mission-card_foot{display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:12px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair)}\n.ab_mission-card_go{color:var(--_color---brand--signal);font-size:11.5px;letter-spacing:0.08em;text-transform:uppercase}\n.ab_mission-card_arrow{display:inline-block;transition:transform 300ms ease}\n.ab_status{display:inline-flex;align-items:center;grid-row-gap:8px;grid-column-gap:8px;color:var(--_color---text--tertiary);font-size:11px;letter-spacing:0.06em;text-transform:uppercase}\n.ab_status_dot{width:7px;height:7px;background-color:var(--_color---text--tertiary)}\n"
}