{
 "html": "<section class=\"section_briefing\" data-frame=\"briefing\" aria-labelledby=\"brief-h\"><span class=\"ab_frame-label\" data-frame-label=\"\" aria-hidden=\"true\">▢ briefing</span><div class=\"padding-global\"><div class=\"container-large\"><div class=\"padding-section-medium\"><div class=\"ab_sec-h\"><div class=\"ab_section-head is-flush\"><div class=\"text-style-eyebrow\">/briefing</div><h2 class=\"heading-style-h2\" id=\"brief-h\" data-split=\"\">The objective</h2></div></div><div class=\"ab_brief\"><div class=\"ab_brief_main\"><p class=\"ab_brief_obj\" data-rich=\"\">The objective, in plain English.</p><p class=\"ab_brief_eng\" data-rich=\"\" data-eng-only=\"\">The objective, for engineers.</p></div><div class=\"ab_brief_side\"><div class=\"text-style-eyebrow ab_brief_params-h\">Mission parameters</div><ul class=\"ab_params\" id=\"params\" role=\"list\"></ul><div class=\"ab_cms-source\" data-field=\"params\" aria-hidden=\"true\">Parameter one</div></div></div></div></div></div></section>",
 "css": ".section_briefing{position:relative}\n.ab_brief{position:relative;z-index:3;display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);grid-row-gap:clamp(24px,4vw,60px);grid-column-gap:clamp(24px,4vw,60px)}\n.ab_brief_obj{font-size:clamp(20px,2.1vw,28px);line-height:1.4;font-weight:500;color:var(--_color---text--primary)}\n.ab_brief_eng{margin-top:18px;padding-left:16px;border-left-width:2px;border-left-style:solid;border-left-color:var(--_color---brand--signal);font-size:14px;line-height:1.7;color:var(--_color---text--secondary)}\n.ab_brief_params-h{margin-bottom:14px}\n.ab_params{margin-top:0;margin-bottom:0;padding-left:0;list-style-type:none;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair)}\n@media screen and (max-width: 991px) {\n.ab_brief{grid-template-columns:minmax(0,1fr)}\n}\n"
}