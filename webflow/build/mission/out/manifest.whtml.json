{
 "html": "<section class=\"section_manifest theme-light\" data-frame=\"manifest\" data-mission-manifest=\"\" aria-labelledby=\"mf-h\"><span class=\"ab_frame-label\" data-frame-label=\"\" aria-hidden=\"true\">▢ manifest</span><div class=\"ab_light-glow is-top\" aria-hidden=\"true\"></div><div class=\"ab_light-glow is-bottom\" aria-hidden=\"true\"></div><div class=\"ab_light-bg\" aria-hidden=\"true\"></div><div class=\"padding-global\"><div class=\"container-large\"><div class=\"padding-section-medium\"><div class=\"ab_sec-h\"><div class=\"ab_section-head is-flush\"><div class=\"text-style-eyebrow\">/manifest · what shipped</div><h2 class=\"heading-style-h2\" id=\"mf-h\" data-split=\"\">Mission <span class=\"t-outline\">manifest</span></h2></div><p class=\"ab_sec-h_lede text-size-lede\">Everything this mission delivered, planned and mocked up first, then built from the ground up.</p></div><div class=\"ab_bento_grid is-manifest\"><div class=\"ab_bento_cell is-xl\"><article class=\"ab_bento-card is-mf\" data-selectable=\"\" data-name=\"Card / pages\"><div class=\"ab_bento-card_viz ab_mf_site\" data-mf=\"pages\"></div><div class=\"ab_bento-card_copy\"><div class=\"ab_bento-card_label text-style-mono\"><span class=\"ab_mf_count\" data-mf=\"count\">0</span> / <span data-mf=\"pages-total\">0</span> <span data-mf=\"pages-label\">pages</span> shipped · hover a tile</div><h3 class=\"ab_bento-card_title\" data-mf=\"pages-title\">Every page, designed then built</h3><p class=\"ab_bento-card_text\" data-field=\"handoff\">What was handed over.</p></div></article></div><div class=\"ab_bento_cell is-tall\"><article class=\"ab_bento-card is-planet is-mf\" data-selectable=\"\" data-name=\"Card / specimen\"><div class=\"ab_bento-card_viz is-planet ab_mf_planet-viz\"><div class=\"ab_planet is-mf\" data-mf=\"planet\" aria-hidden=\"true\"></div><div class=\"ab_mf_ptag text-style-mono\" data-mf=\"planet-tag\">Mission · planet</div></div></article></div><div class=\"ab_bento_cell\"><article class=\"ab_bento-card is-mf\" data-selectable=\"\" data-name=\"Card / role\"><div class=\"ab_bento-card_copy\"><div class=\"ab_bento-card_label text-style-mono\">Role</div><h3 class=\"ab_bento-card_title\" data-field=\"role\">Role</h3><p class=\"ab_bento-card_text\" data-mf=\"role-meta\">Platform · Year</p></div><div class=\"ab_mf_big\" data-mf=\"no\" aria-hidden=\"true\">01</div></article></div><div class=\"ab_bento_cell\"><article class=\"ab_bento-card is-dark is-mf\" data-selectable=\"\" data-name=\"Card / collections\"><div class=\"ab_bento-card_copy\"><div class=\"ab_bento-card_label text-style-mono\">CMS collections</div><h3 class=\"ab_bento-card_title\" data-mf=\"collections-title\">0 collections</h3></div><ul class=\"ab_mf_db\" data-mf=\"collections\" role=\"list\"></ul></article></div><div class=\"ab_bento_cell\"><article class=\"ab_bento-card is-mf\" data-selectable=\"\" data-name=\"Card / type\"><div class=\"ab_bento-card_copy\"><div class=\"ab_bento-card_label text-style-mono\">Mission type</div><h3 class=\"ab_bento-card_title\" data-mf=\"types-title\">0 disciplines</h3><div class=\"ab_mf_hint text-style-mono\">Drag the tags</div></div><div class=\"ab_mf_tags\" data-mf=\"types\"></div></article></div><div class=\"ab_bento_cell is-wide\"><article class=\"ab_bento-card is-mf\" data-selectable=\"\" data-name=\"Card / parameters\"><div class=\"ab_bento-card_copy\"><div class=\"ab_bento-card_label text-style-mono\">Mission parameters</div><h3 class=\"ab_bento-card_title\" data-mf=\"params-title\">All met</h3></div><ul class=\"ab_mf_chk\" data-mf=\"params\" role=\"list\"></ul></article></div><div class=\"ab_bento_cell\"><article class=\"ab_bento-card is-dark is-mf ab_mf_status\" data-selectable=\"\" data-name=\"Card / status\"><div class=\"ab_bento-card_copy\"><div class=\"ab_bento-card_label text-style-mono\">Status</div><h3 class=\"ab_bento-card_title ab_mf_status-title\"><span class=\"ab_mf_dot\" aria-hidden=\"true\"></span><span data-mf=\"status\">Live</span></h3><p class=\"ab_bento-card_text\" data-mf=\"host\">Self-initiated identity</p></div><a class=\"ab_bento-card_link\" href=\"#\" data-mission-live=\"\" target=\"_blank\" aria-label=\"Open the live site\">↗</a></article></div></div></div></div></div></section>",
 "css": ".section_manifest{position:relative}\n.ab_bento_grid.is-manifest{grid-auto-rows:minmax(200px,auto)}\n.ab_bento_cell.is-wide{grid-column:span 4}\n.ab_bento-card.is-dark{background-color:var(--_color---neutral--deep);color:var(--_color---text--primary)}\n.ab_mf_site{display:grid;grid-template-columns:repeat(auto-fill,minmax(118px,1fr));align-content:start;grid-row-gap:28px;grid-column-gap:10px;padding-top:28px;padding-right:14px;padding-bottom:16px;padding-left:14px;overflow-x:visible;overflow-y:visible}\n.ab_mf_planet-viz{display:grid;align-items:center;justify-items:center}\n.ab_planet.is-mf{position:relative;left:auto;top:auto;width:48%}\n.ab_mf_ptag{position:absolute;left:14px;bottom:12px;color:var(--_color---text--tertiary);font-size:10.5px;letter-spacing:0.1em;text-transform:uppercase}\n.ab_mf_count{font-weight:500;color:var(--_color---brand--signal)}\n.ab_mf_big{position:absolute;right:16px;bottom:6px;font-weight:900;font-stretch:125%;font-size:88px;line-height:1;color:transparent;pointer-events:none}\n.ab_mf_db{display:grid;grid-row-gap:6px;grid-column-gap:6px;margin-top:auto;margin-bottom:0;padding-left:0;list-style-type:none}\n.ab_mf_hint{color:var(--_color---text--tertiary);font-size:10.5px;letter-spacing:0.08em;text-transform:uppercase}\n.ab_mf_tags{position:relative;display:flex;flex-wrap:wrap;align-content:flex-end;grid-row-gap:6px;grid-column-gap:6px;min-height:80px;margin-top:auto}\n.ab_mf_chk{display:grid;grid-template-columns:1fr 1fr;grid-row-gap:8px;grid-column-gap:18px;margin-top:0;margin-bottom:0;padding-left:0;list-style-type:none}\n.ab_mf_status{overflow-x:hidden;overflow-y:hidden}\n.ab_mf_status-title{display:flex;align-items:center;grid-row-gap:10px;grid-column-gap:10px}\n.ab_mf_dot{width:10px;height:10px;background-color:#3BE38A}\n@media screen and (max-width: 991px) {\n.ab_bento_cell.is-wide{grid-column:span 2}\n}\n@media screen and (max-width: 479px) {\n.ab_bento_cell.is-wide{grid-column:span 1}\n.ab_mf_chk{grid-template-columns:minmax(0,1fr)}\n.ab_mf_site{grid-template-columns:repeat(2,minmax(0,1fr))}\n}\n"
