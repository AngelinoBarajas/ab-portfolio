{
 "html": "<section class=\"section_palette theme-light\" data-frame=\"palette\" data-mission-palette=\"\" hidden=\"\" aria-labelledby=\"pal-h\"><span class=\"ab_frame-label\" data-frame-label=\"\" aria-hidden=\"true\">▢ palette</span><div class=\"ab_light-bg\" aria-hidden=\"true\"></div><div class=\"padding-global\"><div class=\"container-large\"><div class=\"padding-section-medium\"><div class=\"ab_sec-h\"><div class=\"ab_section-head is-flush\"><div class=\"text-style-eyebrow\">/palette · tap to copy</div><h2 class=\"heading-style-h2\" id=\"pal-h\" data-split=\"\">Color <span class=\"t-outline\">tokens</span></h2></div><p class=\"ab_sec-h_lede text-size-lede\">Six tokens run the whole system. Signal orange is the only accent.</p></div><div class=\"ab_pal\"><button type=\"button\" class=\"ab_swatch\" data-hex=\"#07080D\" data-selectable=\"\" data-name=\"Token / void\"><span class=\"ab_swatch_chip\"></span><span class=\"ab_swatch_name\">Void</span><span class=\"ab_swatch_meta\">#07080D · Page</span></button><button type=\"button\" class=\"ab_swatch\" data-hex=\"#0E1020\" data-selectable=\"\" data-name=\"Token / deep\"><span class=\"ab_swatch_chip\"></span><span class=\"ab_swatch_name\">Deep</span><span class=\"ab_swatch_meta\">#0E1020 · Sections</span></button><button type=\"button\" class=\"ab_swatch\" data-hex=\"#161A2E\" data-selectable=\"\" data-name=\"Token / panel\"><span class=\"ab_swatch_chip\"></span><span class=\"ab_swatch_name\">Panel</span><span class=\"ab_swatch_meta\">#161A2E · Raised</span></button><button type=\"button\" class=\"ab_swatch\" data-hex=\"#F2F0EA\" data-selectable=\"\" data-name=\"Token / starlight\"><span class=\"ab_swatch_chip\"></span><span class=\"ab_swatch_name\">Starlight</span><span class=\"ab_swatch_meta\">#F2F0EA · Text</span></button><button type=\"button\" class=\"ab_swatch\" data-hex=\"#FF6A3D\" data-selectable=\"\" data-name=\"Token / signal\"><span class=\"ab_swatch_chip\"></span><span class=\"ab_swatch_name\">Signal</span><span class=\"ab_swatch_meta\">#FF6A3D · The one accent</span></button><button type=\"button\" class=\"ab_swatch\" data-hex=\"#4C8DFF\" data-selectable=\"\" data-name=\"Token / select\"><span class=\"ab_swatch_chip\"></span><span class=\"ab_swatch_name\">Select</span><span class=\"ab_swatch_meta\">#4C8DFF · Canvas UI only</span></button></div><div class=\"ab_typespec\"><div class=\"ab_typespec_card\"><span class=\"ab_typespec_k text-style-mono\">Display · Archivo Expanded 900</span><span class=\"ab_typespec_display\">Grab it.</span></div><div class=\"ab_typespec_card\"><span class=\"ab_typespec_k text-style-mono\">Body · Geist</span><span class=\"ab_typespec_body\">Websites with the parts people remember.</span></div><div class=\"ab_typespec_card\"><span class=\"ab_typespec_k text-style-mono\">Mono · JetBrains Mono</span><span class=\"ab_typespec_mono\">Frame / 510-visuals<br>1280 × 872 · X 412<br>ALT 38,400 km</span></div></div></div></div></div></section>",
 "css": ".section_palette{position:relative}\n.ab_pal{position:relative;z-index:3;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));grid-row-gap:12px;grid-column-gap:12px}\n.ab_swatch{position:relative;display:flex;flex-direction:column;align-items:flex-start;grid-row-gap:8px;grid-column-gap:8px;padding-top:0;padding-right:0;padding-bottom:0;padding-left:0;border-top-style:none;border-right-style:none;border-bottom-style:none;border-left-style:none;background-color:transparent;color:var(--_color---text--primary);text-align:left;cursor:pointer}\n.ab_swatch_chip{display:block;width:100%;aspect-ratio:1/1.1;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair-strong);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair-strong);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair-strong);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair-strong);transition:transform 350ms cubic-bezier(.2,.9,.2,1.3)}\n.ab_swatch_name{font-weight:600}\n.ab_swatch_meta{font-size:11.5px;color:var(--_color---text--tertiary)}\n.ab_typespec{position:relative;z-index:3;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-row-gap:16px;grid-column-gap:16px;margin-top:20px}\n.ab_typespec_card{display:flex;flex-direction:column;grid-row-gap:12px;grid-column-gap:12px;padding-top:22px;padding-right:22px;padding-bottom:22px;padding-left:22px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:var(--_color---neutral--deep)}\n.ab_typespec_k{color:var(--_color---text--tertiary);text-transform:uppercase}\n.ab_typespec_display{font-weight:900;font-stretch:125%;font-size:56px;line-height:0.9;text-transform:uppercase}\n.ab_typespec_body{font-size:22px;line-height:1.35;font-weight:500}\n.ab_typespec_mono{font-size:15px;line-height:1.8;color:var(--_color---text--primary)}\n@media screen and (max-width: 991px) {\n.ab_typespec{grid-template-columns:minmax(0,1fr)}\n}\n@media screen and (max-width: 767px) {\n.ab_pal{grid-template-columns:repeat(3,minmax(0,1fr))}\n}\n"
}