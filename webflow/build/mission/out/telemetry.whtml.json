{
 "html": "<section class=\"section_telemetry\" data-frame=\"telemetry\" aria-labelledby=\"tel-h\"><span class=\"ab_frame-label\" data-frame-label=\"\" aria-hidden=\"true\">▢ telemetry</span><div class=\"padding-global\"><div class=\"container-large\"><div class=\"padding-section-medium\"><div class=\"ab_sec-h\"><div class=\"ab_section-head is-flush\"><div class=\"text-style-eyebrow\">/telemetry</div><h2 class=\"heading-style-h2\" id=\"tel-h\" data-split=\"\">By the <span class=\"t-outline\">numbers</span></h2></div></div><div class=\"ab_tel\" id=\"tel\"></div><div class=\"ab_stack_grid is-mission\"><div class=\"ab_section-head\"><div class=\"text-style-eyebrow\">/stack · <span data-mission=\"tools\">0</span> tools</div><h3 class=\"ab_stk_h\">Tools in <span class=\"t-outline\">orbit</span></h3><p class=\"ab_section-lede text-size-lede\">Every tool this mission ran on. Pull one out of orbit and let go; it finds its way back.</p><div class=\"ab_stack_readout\" id=\"stkReadout\" aria-live=\"polite\"><div class=\"ab_stack_ci\" aria-hidden=\"true\"></div><div class=\"ab_stack_readout-body\"><div class=\"ab_stack_readout-title\">Hover a tool</div><p class=\"ab_stack_readout-text text-style-mono\">Tools in orbit</p></div></div></div><div class=\"ab_stack_orbit\" id=\"stkOrbit\"><div class=\"ab_stack_ring is-inner\" aria-hidden=\"true\"></div><div class=\"ab_stack_ring is-outer\" aria-hidden=\"true\"></div><div class=\"ab_planet is-orbit\" data-mf=\"stack-planet\" aria-hidden=\"true\"></div></div></div></div></div></div></section>",
 "css": ".section_telemetry{position:relative}\n.ab_tel{position:relative;z-index:3}\n.ab_tel-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair)}\n.ab_tel_item{padding-top:24px;padding-right:20px;padding-bottom:6px;padding-left:20px;border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair)}\n.ab_tel_n{font-weight:900;font-stretch:118%;font-size:clamp(46px,6vw,92px);line-height:1}\n.ab_tel_l{max-width:24ch;margin-top:10px;color:var(--_color---text--secondary)}\n.ab_stack_grid.is-mission{margin-top:56px}\n.ab_stk_h{margin-top:12px;margin-bottom:14px;font-weight:900;font-stretch:118%;font-size:clamp(30px,4vw,56px);line-height:0.95;text-transform:uppercase}\n@media screen and (max-width: 991px) {\n.ab_tel-grid{grid-template-columns:repeat(2,minmax(0,1fr))}\n.ab_tel_item{border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair)}\n}\n"
}