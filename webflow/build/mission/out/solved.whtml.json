{
 "html": "<section class=\"section_solved\" data-frame=\"problems-solved\" aria-labelledby=\"solved-h\"><span class=\"ab_frame-label\" data-frame-label=\"\" aria-hidden=\"true\">▢ problems-solved</span><div class=\"padding-global\"><div class=\"container-large\"><div class=\"padding-section-medium\"><div class=\"ab_sec-h\"><div class=\"ab_section-head is-flush\"><div class=\"text-style-eyebrow\">/impact · <span data-mission=\"solved\">5</span> problems solved</div><h2 class=\"heading-style-h2\" id=\"solved-h\" data-split=\"\">Problems <span class=\"t-outline\">solved</span></h2></div><p class=\"ab_sec-h_lede text-size-lede\" data-mission-lede=\"solved\">What the site does for the people who run it and the people who visit it.</p></div><div class=\"ab_anoms\" id=\"anoms\"></div></div></div></div></section>",
 "css": ".section_solved{position:relative}\n.ab_anoms{position:relative;z-index:3}\n.ab_anoms-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-row-gap:16px;grid-column-gap:16px}\n.ab_anom{position:relative;display:flex;flex-direction:column;padding-top:22px;padding-right:22px;padding-bottom:24px;padding-left:22px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:rgba(14,16,32,0.9)}\n.ab_anom_top{display:flex;align-items:center;grid-row-gap:10px;grid-column-gap:10px;color:var(--_color---text--tertiary);font-size:11px;letter-spacing:0.08em;text-transform:uppercase}\n.ab_anom_who{padding-top:4px;padding-right:8px;padding-bottom:4px;padding-left:8px;border-top-width:1px;border-top-style:solid;border-top-color:currentColor;border-right-width:1px;border-right-style:solid;border-right-color:currentColor;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:currentColor;border-left-width:1px;border-left-style:solid;border-left-color:currentColor;letter-spacing:0.1em;color:var(--_color---brand--signal)}\n.ab_anom_title{max-width:24ch;margin-top:14px;margin-bottom:14px;padding-right:96px;font-weight:800;font-stretch:112%;font-size:clamp(19px,1.8vw,24px);line-height:1.1;text-transform:uppercase}\n.ab_anom_row{display:grid;grid-template-columns:78px 1fr;grid-row-gap:12px;grid-column-gap:12px;padding-top:10px;padding-bottom:10px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);color:var(--_color---text--secondary);font-size:15px}\n.ab_anom_k{padding-top:3px;color:var(--_color---text--tertiary);text-transform:uppercase}\n.ab_anom_row.is-fix{transition:opacity 600ms ease,filter 600ms ease}\n.ab_anom_eng{margin-top:4px;padding-top:12px;border-top-width:1px;border-top-style:dashed;border-top-color:var(--_color---neutral--hair-strong);color:var(--_color---text--tertiary);font-size:14px}\n.ab_anom_eng-k{display:block;margin-bottom:6px;color:#7cc4ff;font-size:11px;letter-spacing:0.1em;text-transform:uppercase}\n.ab_anom_eng-p{line-height:1.55}\n.ab_stamp{position:absolute;right:18px;top:44px;padding-top:6px;padding-right:10px;padding-bottom:6px;padding-left:10px;border-top-width:2px;border-top-style:solid;border-top-color:#3BE38A;border-right-width:2px;border-right-style:solid;border-right-color:#3BE38A;border-bottom-width:2px;border-bottom-style:solid;border-bottom-color:#3BE38A;border-left-width:2px;border-left-style:solid;border-left-color:#3BE38A;color:#3BE38A;font-size:13px;font-weight:500;letter-spacing:0.14em;opacity:0.9;pointer-events:none;transform:rotate(-8deg)}\n@media screen and (max-width: 991px) {\n.ab_anoms-grid{grid-template-columns:minmax(0,1fr)}\n.ab_anom{padding-bottom:66px}\n.ab_anom_title{padding-right:0}\n.ab_stamp{top:auto;bottom:16px;right:16px}\n}\n"
}