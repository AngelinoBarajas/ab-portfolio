{
 "html": "<section class=\"section_dbh\" id=\"hero\" data-frame=\"debrief\" aria-labelledby=\"heroTitle\"><span class=\"ab_frame-label\" data-frame-label=\"\" aria-hidden=\"true\">▢ debrief</span><div class=\"padding-global\"><div class=\"container-large\"><div class=\"ab_dbh\"><div class=\"ab_planet is-dbh\" data-drag=\"\" data-label=\"Mission planet\"></div><div class=\"ab_dbh_top\"><div class=\"ab_crumb text-style-mono\"><a class=\"ab_crumb_link\" href=\"/work\">/work</a><span class=\"ab_crumb_sep\">/</span><div class=\"ab_crumb_current\" data-field=\"slug\">mission-slug</div></div><nav class=\"ab_mswitch\" id=\"mswitch\" aria-label=\"Missions\"></nav></div><div class=\"ab_dbh_eyebrow text-style-mono\">Mission debrief · <span data-mission=\"no\">01</span> / <span data-mission=\"total\">03</span></div><h1 class=\"ab_dbh_title is-debrief\" id=\"heroTitle\">Mission name</h1><p class=\"ab_dbh_sum\">Mission summary.</p><div class=\"ab_crew\" id=\"crew\"><span class=\"ab_crew_label text-style-mono\">Crew level</span><div class=\"ab_switch\" data-crew-switch=\"\" role=\"group\" aria-label=\"Explanation depth\"><span class=\"ab_switch_ind\" aria-hidden=\"true\"></span><button type=\"button\" class=\"ab_switch_btn\" data-lv=\"cadet\" aria-pressed=\"true\">Cadet</button><button type=\"button\" class=\"ab_switch_btn\" data-lv=\"eng\" aria-pressed=\"false\">Engineer</button></div><span class=\"ab_crew_hint\" id=\"crewHint\">Plain-English briefings. Switch to Engineer for the technical details.</span></div><div class=\"ab_meta\"><div class=\"ab_meta_item\"><div class=\"ab_meta_label\">Client</div><div class=\"ab_meta_value\" data-field=\"client\">Client</div></div><div class=\"ab_meta_item\"><div class=\"ab_meta_label\">Mission type</div><div class=\"ab_meta_chips\" data-meta-types=\"\"></div></div><div class=\"ab_meta_item\"><div class=\"ab_meta_label\">Role</div><div class=\"ab_meta_value\" data-field=\"role\">Role</div></div><div class=\"ab_meta_item\"><div class=\"ab_meta_label\">Year</div><div class=\"ab_meta_value\" data-field=\"year\">2026</div></div><div class=\"ab_meta_item\"><div class=\"ab_meta_label\">Platform</div><div class=\"ab_meta_value\" data-field=\"platform\">Webflow</div></div><div class=\"ab_meta_item\"><div class=\"ab_meta_label\">Status</div><div class=\"ab_meta_value\"><a class=\"ab_meta_live\" href=\"#\" data-mission-live=\"\" target=\"_blank\"><div class=\"ab_meta_live-text\" data-field=\"status\">Live</div><span class=\"ab_meta_live-arrow\" aria-hidden=\"true\">↗</span></a></div></div></div></div></div></div></section>",
 "css": ".section_dbh{position:relative}\n.ab_crumb{display:flex;align-items:center;grid-row-gap:6px;grid-column-gap:6px}\n.ab_crumb_sep{color:var(--_color---text--tertiary)}\n.ab_mswitch{display:flex;flex-wrap:wrap;grid-row-gap:6px;grid-column-gap:6px}\n.ab_dbh_title.is-debrief{max-width:12ch}\n.ab_crew{position:relative;z-index:4;display:flex;flex-wrap:wrap;align-items:center;grid-row-gap:10px;grid-column-gap:10px;margin-top:26px}\n.ab_crew_label{color:var(--_color---text--tertiary);text-transform:uppercase;letter-spacing:0.1em}\n.ab_crew_hint{color:var(--_color---text--tertiary);font-size:14px}\n.ab_meta_chips{display:flex;flex-wrap:wrap;grid-row-gap:5px;grid-column-gap:5px}\n.ab_meta_chip{padding-top:3px;padding-right:7px;padding-bottom:3px;padding-left:7px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair-strong);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair-strong);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair-strong);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair-strong);color:var(--_color---text--secondary);font-size:10.5px;letter-spacing:0.05em;text-transform:uppercase}\n.ab_meta_live{display:inline-flex;align-items:center;grid-row-gap:8px;grid-column-gap:8px;color:#3BE38A;text-decoration:none}\n.ab_meta_live:hover{text-decoration:underline}\n@media screen and (max-width: 767px) {\n.ab_dbh_title.is-debrief{max-width:none}\n}\n"
}