{
 "html": "<section class=\"section_debrief-quote\" data-frame=\"crew-debrief\" data-mission-quote=\"\" aria-label=\"Crew debrief\"><span class=\"ab_frame-label\" data-frame-label=\"\" aria-hidden=\"true\">▢ crew-debrief</span><div class=\"padding-global\"><div class=\"container-large\"><div class=\"ab_dbq-wrap\"><figure class=\"ab_dbq\" data-selectable=\"\" data-name=\"Quote / crew-debrief\"><div class=\"text-style-eyebrow\">/crew-debrief</div><blockquote class=\"ab_dbq_text\" data-field=\"quote\">Client quote.</blockquote><figcaption class=\"ab_dbq_by text-style-mono\" data-field=\"quote-by\">Name · Company</figcaption></figure></div></div></div></section>",
 "css": ".section_debrief-quote{position:relative}\n.ab_dbq-wrap{padding-top:60px}\n.ab_dbq{position:relative;z-index:3;margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;padding-top:clamp(24px,4vw,48px);padding-right:clamp(24px,4vw,48px);padding-bottom:clamp(24px,4vw,48px);padding-left:clamp(24px,4vw,48px);border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:rgba(14,16,32,0.88)}\n.ab_dbq_text{max-width:36ch;margin-top:18px;margin-bottom:0;padding-top:0;padding-right:0;padding-bottom:0;padding-left:0;border-left-style:none;font-size:clamp(22px,2.4vw,32px);line-height:1.35;font-weight:500}\n.ab_dbq_by{margin-top:20px;color:var(--_color---text--tertiary)}\n"
