{
 "html": "<section class=\"section_contact\" id=\"launch\" data-frame=\"contact\" aria-labelledby=\"launch-h\"><div class=\"padding-global\"><div class=\"container-large\"><div class=\"padding-section-large\"><div class=\"ab_contact_grid\"><div class=\"ab_contact_copy\"><div class=\"text-style-eyebrow\">/contact · replies within one business day</div><h2 class=\"ab_contact_title heading-style-h2\" id=\"launch-h\" data-split=\"\">Ready for<br><span class=\"t-stars\">liftoff?</span></h2><p class=\"ab_contact_lede text-size-lede\">Plot the mission on the console. I'll reply within one business day with a flight plan, a timeline and a quote.</p><ol class=\"ab_contact_steps text-style-mono\"><li class=\"ab_contact_step\"><span class=\"ab_contact_step-num\">01</span>You plot the mission</li><li class=\"ab_contact_step\"><span class=\"ab_contact_step-num\">02</span>A 30-minute discovery call</li><li class=\"ab_contact_step\"><span class=\"ab_contact_step-num\">03</span>Flight plan, timeline + quote</li></ol><div class=\"ab_contact_row\"></div></div><div class=\"ab_contact_form-slot\"></div></div></div></div></div></section>",
 "css": ".section_contact{position:relative}\n.ab_contact_grid{position:relative;z-index:3;display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);align-items:start;grid-row-gap:clamp(32px,5vw,80px);grid-column-gap:clamp(32px,5vw,80px)}\n.ab_contact_copy{position:sticky;top:110px;min-width:0;container-type:inline-size}\n.ab_contact_title.heading-style-h2{position:relative;z-index:3;margin-top:22px;font-size:clamp(40px,12.5cqw,112px)}\n.ab_contact_lede{max-width:40ch;margin-top:26px;color:var(--_color---text--secondary)}\n.ab_contact_steps{display:grid;max-width:420px;margin-top:30px;margin-right:0;margin-bottom:0;margin-left:0;padding-top:0;padding-right:0;padding-bottom:0;padding-left:0;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);list-style-type:none}\n.ab_contact_step{display:flex;align-items:center;grid-row-gap:16px;grid-column-gap:16px;padding-top:14px;padding-right:0;padding-bottom:14px;padding-left:0;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);color:var(--_color---text--secondary);font-size:13px;letter-spacing:0.04em}\n.ab_contact_step-num{color:var(--_color---brand--signal);font-weight:500}\n.ab_contact_row{position:relative;z-index:3;display:flex;flex-wrap:wrap;align-items:center;grid-row-gap:18px;grid-column-gap:18px;margin-top:28px}\n.ab_contact_form-slot{min-width:0}\n@media screen and (max-width: 991px) {\n.ab_contact_grid{grid-template-columns:minmax(0,1fr)}\n.ab_contact_copy{position:static}\n}\n"
}