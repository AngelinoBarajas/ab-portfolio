{
 "html": "<section class=\"section_process\" id=\"log\" data-frame=\"process\" aria-labelledby=\"log-h\"><div class=\"padding-global\"><div class=\"container-large\"><div class=\"padding-section-medium\"><div class=\"ab_process_pin\"><div class=\"ab_process_head\"><div class=\"ab_section-head is-flush\"><div class=\"text-style-eyebrow\">/process · 6 stages</div><h2 class=\"ab_process_title heading-style-h2\" id=\"log-h\" data-split=\"\">Mission <span class=\"t-outline\">sequence</span></h2></div><p class=\"ab_process_lede text-size-lede\">Every project flies the same six-stage plan, so you always know where we are and what happens next.</p></div><div class=\"ab_process_traj\" aria-hidden=\"true\"></div><div class=\"ab_process_panel\" aria-live=\"polite\"><div class=\"ab_process_main\"><div class=\"ab_process_code text-style-mono\">STAGE <span class=\"ab_process_code-num\" id=\"mpNum\">01</span> / 06 · <span id=\"mpCode\">PRE-FLIGHT</span></div><h3 class=\"ab_process_panel-title\" id=\"mpTitle\">Discovery call</h3><p class=\"ab_process_panel-copy\" id=\"mpCopy\">A call to learn your goals, your audience and what a win looks like.</p></div><div class=\"ab_process_meta\"><div><div class=\"ab_process_meta-label\">Deliverable</div><div class=\"ab_process_meta-value\" id=\"mpDeliv\">Creative brief</div></div><div><div class=\"ab_process_meta-label\">Your part</div><div class=\"ab_process_meta-value\" id=\"mpYou\">Share your goals, sites you like and any brand files.</div></div></div><div class=\"ab_process_side\"><ul class=\"ab_process_check\" id=\"mpCheck\"></ul><div class=\"ab_process_foot\"><div class=\"ab_process_bar\"><div class=\"ab_process_bar-fill\" id=\"mpBar\"></div></div><div class=\"ab_process_pct text-style-mono\" id=\"mpPct\">0%</div><button type=\"button\" class=\"ab_process_btn\" id=\"mpPrev\" aria-label=\"Previous stage\">←</button><button type=\"button\" class=\"ab_process_btn\" id=\"mpNext\" aria-label=\"Next stage\">→</button></div></div></div><ol class=\"ab_process_steps\"><li class=\"ab_process_step\" data-code=\"Pre-flight\" data-deliverable=\"Creative brief\" data-you=\"Share your goals, sites you like and any brand files.\" data-check=\"Goals + audience defined|Examples collected|Creative brief sent\"><div class=\"ab_process_step-code text-style-mono\">01 · Pre-flight</div><h3 class=\"ab_process_step-title\">Discovery call</h3><p class=\"ab_process_step-text\">A call to learn your goals, your audience and what a win looks like.</p></li><li class=\"ab_process_step\" data-code=\"Flight plan\" data-deliverable=\"Site map + timeline\" data-you=\"Sign off on scope and dates.\" data-check=\"Site map approved|Scope + timeline locked|Content plan assigned\"><div class=\"ab_process_step-code text-style-mono\">02 · Flight plan</div><h3 class=\"ab_process_step-title\">Alignment</h3><p class=\"ab_process_step-text\">We agree on the site map, scope, timeline and content plan before any pixels move.</p></li><li class=\"ab_process_step\" data-code=\"Payload\" data-deliverable=\"Brand kit + design tokens\" data-you=\"Send logos, photos and copy, or I create them.\" data-check=\"Logo + colors set|Type scale defined|Assets organized\"><div class=\"ab_process_step-code text-style-mono\">03 · Payload</div><h3 class=\"ab_process_step-title\">Brand + assets</h3><p class=\"ab_process_step-text\">Logo, color, type and imagery, gathered or designed, then turned into design tokens.</p></li><li class=\"ab_process_step\" data-code=\"Test flight\" data-deliverable=\"Clickable prototype\" data-you=\"Two rounds of feedback, live or async.\" data-check=\"Key pages designed|Motion prototyped|Feedback rounds done\"><div class=\"ab_process_step-code text-style-mono\">04 · Test flight</div><h3 class=\"ab_process_step-title\">Prototype</h3><p class=\"ab_process_step-text\">Key pages as interactive prototypes with motion, reviewed together before the build.</p></li><li class=\"ab_process_step\" data-code=\"Assembly\" data-deliverable=\"Staging site\" data-you=\"Load content and test on your own devices.\" data-check=\"CMS built + populated|Custom code hosted|QA across devices\"><div class=\"ab_process_step-code text-style-mono\">05 · Assembly</div><h3 class=\"ab_process_step-title\">Build</h3><p class=\"ab_process_step-text\">The Webflow build: CMS, custom code and QA across browsers, devices and reduced motion.</p></li><li class=\"ab_process_step\" data-code=\"Launch\" data-deliverable=\"Live site + handoff\" data-you=\"Celebrate. Then tell people.\" data-check=\"Domain + SSL live|Analytics connected|Handoff guide + video\"><div class=\"ab_process_step-code text-style-mono\">06 · Launch</div><h3 class=\"ab_process_step-title\">Deploy</h3><p class=\"ab_process_step-text\">Go live, connect analytics, and hand over a guide and walkthrough so your team owns it.</p></li></ol></div></div></div></div></section>",
 "css": ".section_process{position:relative}\n.ab_process_pin{position:relative;z-index:3}\n.ab_process_head{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;grid-row-gap:24px;grid-column-gap:48px}\n.ab_section-head.is-flush{margin-bottom:0}\n.ab_process_title.heading-style-h2{font-size:clamp(40px,5.2vw,80px)}\n.ab_process_lede{max-width:40ch;color:var(--_color---text--secondary)}\n.ab_process_traj{position:relative;display:none;width:100%;aspect-ratio:1200/280;margin-top:18px}\n.ab_process_panel{display:none;grid-template-columns:minmax(0,5fr) minmax(0,4fr) minmax(0,4fr);grid-row-gap:28px;grid-column-gap:28px;min-height:190px;margin-top:22px;padding-top:22px;padding-right:24px;padding-bottom:22px;padding-left:24px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:rgba(14,16,32,0.88)}\n.ab_process_code{color:var(--_color---brand--signal);letter-spacing:0.12em}\n.ab_process_code-num{font-weight:500}\n.ab_process_panel-title{margin-top:8px;margin-bottom:10px;font-weight:800;font-stretch:112%;font-size:clamp(24px,2.4vw,34px);line-height:1.05;text-transform:uppercase}\n.ab_process_panel-copy{max-width:44ch;font-size:16px;line-height:1.55;color:var(--_color---text--secondary)}\n.ab_process_meta{display:flex;flex-direction:column;grid-row-gap:14px;grid-column-gap:14px;padding-left:24px;border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair)}\n.ab_process_meta-label{font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--_color---text--tertiary)}\n.ab_process_meta-value{margin-top:4px;font-size:16px;line-height:1.45;color:var(--_color---text--primary)}\n.ab_process_side{display:flex;flex-direction:column;justify-content:space-between;grid-row-gap:16px;grid-column-gap:16px;padding-left:24px;border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair)}\n.ab_process_check{display:flex;flex-direction:column;grid-row-gap:10px;grid-column-gap:10px;margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;padding-top:0;padding-right:0;padding-bottom:0;padding-left:0;list-style-type:none}\n.ab_process_foot{display:flex;align-items:center;grid-row-gap:10px;grid-column-gap:10px}\n.ab_process_bar{position:relative;flex-grow:1;flex-shrink:1;flex-basis:0%;height:3px;background-color:var(--_color---neutral--hair)}\n.ab_process_bar-fill{position:absolute;left:0;top:0;bottom:0;width:0%;background-color:var(--_color---brand--signal)}\n.ab_process_pct{min-width:4ch;text-align:right;color:var(--_color---text--primary)}\n.ab_process_btn{display:grid;align-items:center;justify-items:center;width:36px;height:36px;padding-top:0;padding-right:0;padding-bottom:0;padding-left:0;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair-strong);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair-strong);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair-strong);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair-strong);background-color:transparent;color:var(--_color---text--primary);cursor:pointer;transition:border-color 200ms ease,color 200ms ease,background-color 200ms ease}\n.ab_process_btn:hover{border-top-color:var(--_color---brand--signal);border-right-color:var(--_color---brand--signal);border-bottom-color:var(--_color---brand--signal);border-left-color:var(--_color---brand--signal);color:var(--_color---brand--signal)}\n.ab_process_steps{position:relative;display:flex;flex-direction:column;grid-row-gap:14px;grid-column-gap:14px;margin-top:32px;margin-right:0;margin-bottom:0;margin-left:0;padding-top:0;padding-right:0;padding-bottom:0;padding-left:30px;list-style-type:none}\n.ab_process_step{position:relative;padding-top:16px;padding-right:18px;padding-bottom:16px;padding-left:18px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:rgba(14,16,32,0.88);transition:border-color 300ms ease}\n.ab_process_step-code{color:var(--_color---brand--signal);text-transform:uppercase;letter-spacing:0.12em}\n.ab_process_step-title{margin-top:6px;margin-bottom:6px;font-weight:800;font-stretch:112%;font-size:22px;line-height:1.1;text-transform:uppercase}\n.ab_process_step-text{font-size:15px;color:var(--_color---text--secondary)}\n"
}