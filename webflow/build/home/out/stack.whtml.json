{
 "html": "<section class=\"section_stack\" data-frame=\"stack\" aria-labelledby=\"orbit-h\"><div class=\"padding-global\"><div class=\"container-large\"><div class=\"padding-section-large\"><div class=\"ab_stack_grid\"><div class=\"ab_section-head\"><div class=\"text-style-eyebrow\">/stack</div><h2 class=\"heading-style-h2\" id=\"orbit-h\" data-split=\"\">Tools in <span class=\"t-orbit\">orbit</span></h2><p class=\"ab_section-lede text-size-lede\">Pull a tool out of orbit and let go. It finds its way back.</p><div class=\"ab_stack_readout\" id=\"toolReadout\" aria-live=\"polite\"><div class=\"ab_stack_ci\" aria-hidden=\"true\"></div><div class=\"ab_stack_readout-body\"><div class=\"ab_stack_readout-title\">Hover a tool</div><p class=\"ab_stack_readout-text text-style-mono\">9 tools · 2 orbits</p></div></div></div><div class=\"ab_stack_orbit\" id=\"orbit\"><div class=\"ab_stack_ring is-inner\" aria-hidden=\"true\"></div><div class=\"ab_stack_ring is-outer\" aria-hidden=\"true\"></div><div class=\"ab_planet is-orbit\" data-planet=\"gas\" data-seed=\"8\" data-colors=\"#3b1f12,#a44a1f,#ff8a4c,#ffd29a,#6b2b16\" data-spin=\"40\" data-glow=\"rgba(255,106,61,.35)\" aria-hidden=\"true\"></div></div></div></div></div></div></section>",
 "css": ".section_stack{position:relative}\n.ab_stack_grid{position:relative;z-index:3;display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);align-items:center;grid-row-gap:clamp(24px,5vw,80px);grid-column-gap:clamp(24px,5vw,80px)}\n.ab_stack_readout{display:flex;align-items:center;grid-row-gap:14px;grid-column-gap:14px;width:min(420px,100%);min-height:92px;margin-top:10px;padding-top:14px;padding-right:16px;padding-bottom:14px;padding-left:16px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:rgba(14,16,32,0.7);transition:border-color 300ms ease}\n.ab_stack_ci{display:grid;align-items:center;justify-items:center;flex-grow:0;flex-shrink:0;flex-basis:auto;width:40px;height:40px;background-color:var(--_color---neutral--hair-strong);color:var(--_color---neutral--void)}\n.ab_stack_readout-body{flex-grow:1;flex-shrink:1;flex-basis:0%;min-width:0}\n.ab_stack_readout-title{font-weight:800;font-stretch:112%;font-size:18px;line-height:1.1;text-transform:uppercase}\n.ab_stack_readout-text{min-height:2.9em;margin-top:4px;line-height:1.45;letter-spacing:0.02em;color:var(--_color---text--secondary)}\n.ab_stack_orbit{position:relative;width:min(620px,100%);aspect-ratio:1;margin-left:auto;margin-right:auto}\n.ab_stack_ring{position:absolute;left:50%;top:50%;border-top-width:1px;border-top-style:dashed;border-top-color:var(--_color---neutral--hair-strong);border-right-width:1px;border-right-style:dashed;border-right-color:var(--_color---neutral--hair-strong);border-bottom-width:1px;border-bottom-style:dashed;border-bottom-color:var(--_color---neutral--hair-strong);border-left-width:1px;border-left-style:dashed;border-left-color:var(--_color---neutral--hair-strong);border-top-left-radius:50%;border-top-right-radius:50%;border-bottom-right-radius:50%;border-bottom-left-radius:50%;transform:translate(-50%,-50%)}\n.ab_stack_ring.is-inner{width:60%;height:54%}\n.ab_stack_ring.is-outer{width:92%;height:83%}\n.ab_planet.is-orbit{left:36%;top:36%;width:28%}\n.ab_stack_chip{position:absolute;left:50%;top:50%;z-index:4;display:flex;align-items:center;grid-row-gap:9px;grid-column-gap:9px;padding-top:6px;padding-right:12px;padding-bottom:6px;padding-left:6px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair-strong);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair-strong);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair-strong);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair-strong);border-top-left-radius:0;border-top-right-radius:0;border-bottom-right-radius:0;border-bottom-left-radius:0;background-color:var(--_color---neutral--panel);color:var(--_color---text--primary);font-size:12px;letter-spacing:0.04em;white-space:nowrap;cursor:grab;touch-action:none;transition:border-color 250ms ease,box-shadow 250ms ease}\n@media screen and (max-width: 991px) {\n.ab_stack_grid{grid-template-columns:minmax(0,1fr)}\n}\n"
