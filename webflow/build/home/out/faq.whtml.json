{
 "html": "<section class=\"section_faq\" data-frame=\"faq\" aria-labelledby=\"faq-h\"><div class=\"padding-global\"><div class=\"container-large\"><div class=\"padding-section-large\"><div class=\"ab_section-head\"><div class=\"text-style-eyebrow\">/faq</div><h2 class=\"heading-style-h2\" id=\"faq-h\" data-split=\"\">Pre-flight <span class=\"t-select\" data-selectable=\"\" data-name=\"Text / checks\">checks</span></h2></div><div class=\"ab_faq_list\"><details class=\"ab_faq_item\"><summary class=\"ab_faq_summary\"><div class=\"ab_faq_question\">Do you only build in Webflow?</div><span class=\"ab_faq_icon\" aria-hidden=\"true\">+</span></summary><p class=\"ab_faq_answer\">Webflow is home base, because clients can edit it after launch. The custom pieces (3D scenes, maps, scroll systems) are plain JavaScript hosted on GitHub, so they aren't locked to one platform.</p></details></div></div></div></div></section>",
 "css": ".section_faq{position:relative}\n.ab_faq_list{position:relative;z-index:3;display:flex;flex-direction:column;max-width:980px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair)}\n.ab_faq_item{border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair)}\n.ab_faq_summary{display:flex;justify-content:space-between;align-items:center;grid-row-gap:20px;grid-column-gap:20px;padding-top:24px;padding-right:0;padding-bottom:24px;padding-left:0;list-style-type:none;cursor:pointer;font-size:clamp(18px,1.8vw,22px);font-weight:500}\n.ab_faq_icon{display:grid;align-items:center;justify-items:center;flex-grow:0;flex-shrink:0;flex-basis:auto;width:34px;height:34px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair-strong);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair-strong);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair-strong);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair-strong);transition:transform 300ms ease,background-color 300ms ease,color 300ms ease,border-color 300ms ease}\n.ab_faq_answer{max-width:70ch;padding-top:0;padding-right:60px;padding-bottom:26px;padding-left:0;overflow-x:hidden;overflow-y:hidden;color:var(--_color---text--secondary)}\n"
}