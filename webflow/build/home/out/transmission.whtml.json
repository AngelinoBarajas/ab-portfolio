{
 "html": "<section class=\"section_transmission\" data-frame=\"transmission\" aria-label=\"Space exploration quote\"><div class=\"padding-global\"><div class=\"container-large\"><div class=\"ab_transmission_inner\"><div class=\"ab_transmission_top text-style-mono\"><div class=\"ab_transmission_live\">Incoming transmission</div><div><span id=\"iqIdx\">01</span> / <span id=\"iqTotal\">05</span></div></div><blockquote class=\"ab_transmission_quote\" id=\"iq\"><p class=\"ab_transmission_text\" id=\"iqText\">Earth is the cradle of humanity, but one cannot live in the cradle forever.</p><div class=\"ab_transmission_by text-style-mono\" id=\"iqBy\">Konstantin Tsiolkovsky, 1911</div></blockquote><div class=\"ab_transmission_action\"><button type=\"button\" class=\"button is-ghost\" id=\"iqNext\" data-magnetic=\"\">Next transmission</button></div></div></div></div></section>",
 "css": ".section_transmission{position:relative}\n.ab_transmission_inner{padding-top:clamp(90px,12vw,170px);padding-bottom:clamp(90px,12vw,170px)}\n.ab_transmission_top{position:relative;z-index:3;display:flex;justify-content:space-between;padding-bottom:14px;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);color:var(--_color---text--tertiary);text-transform:uppercase;letter-spacing:0.12em}\n.ab_transmission_live{display:flex;align-items:center;grid-row-gap:8px;grid-column-gap:8px;color:var(--_color---brand--signal)}\n.ab_transmission_quote{position:relative;z-index:3;margin-top:clamp(28px,4vw,48px);margin-right:0;margin-bottom:32px;margin-left:0;padding-top:0;padding-right:0;padding-bottom:0;padding-left:0;border-left-style:none;font-size:inherit;line-height:inherit}\n.ab_transmission_text{max-width:20ch;font-weight:800;font-stretch:108%;font-size:clamp(32px,5.2vw,78px);line-height:1.02;letter-spacing:-0.02em;text-transform:uppercase}\n.ab_transmission_by{display:flex;align-items:center;grid-row-gap:10px;grid-column-gap:10px;margin-top:22px;color:var(--_color---text--tertiary);letter-spacing:0.08em;text-transform:uppercase}\n.ab_transmission_action{position:relative;z-index:3}\n"
}