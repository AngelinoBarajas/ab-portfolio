{
 "html": "<section class=\"section_statement\" data-frame=\"about\" aria-labelledby=\"stmt-h\"><div class=\"ab_planet is-statement\" data-planet=\"ice\" data-seed=\"21\" data-colors=\"#bff3ef,#5fb6c4,#1f5a78,#e8fbff\" data-ring=\"#d7f3f4,#86bfc9,#3b6d7f\" data-tilt=\"22\" data-open=\".2\" data-spin=\"90\" data-glow=\"rgba(79,209,197,.28)\" data-parallax=\"-120\" data-label=\"Ringed ice giant\"></div><div class=\"padding-global\"><div class=\"container-large\"><div class=\"padding-section-large\"><div class=\"text-style-eyebrow\">/about</div><h2 class=\"ab_statement_heading heading-style-statement\" id=\"stmt-h\" data-split=\"\">Build the part people <em class=\"ab_statement_accent t-select\" data-selectable=\"\" data-name=\"Text / screenshot\">screenshot.</em> Make the rest load fast.</h2><div class=\"ab_metrics\"><div class=\"ab_metric\"><div class=\"ab_metric_number\" data-count=\"11\">11</div><p class=\"ab_metric_label\">projects pinned on the 510 Visuals globe</p></div><div class=\"ab_metric\"><div class=\"ab_metric_number\" data-count=\"14\">14</div><p class=\"ab_metric_label\">states plotted on the Aguirre case-results map</p></div><div class=\"ab_metric\"><div class=\"ab_metric_number\" data-count=\"2\">2</div><p class=\"ab_metric_label\">languages on one toggle, English and Spanish</p></div></div></div></div></div></section>",
 "css": ".section_statement{position:relative}\n.ab_planet.is-statement{width:clamp(150px,24vw,360px);right:calc(clamp(150px,24vw,360px) * 0.7);top:8%}\n.ab_statement_heading{position:relative;z-index:3;max-width:17ch;margin-top:22px;letter-spacing:-0.02em;text-transform:uppercase}\n.ab_statement_accent{font-style:normal;color:var(--_color---brand--signal)}\n.ab_metrics{position:relative;z-index:3;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,1fr);margin-top:clamp(40px,6vw,80px);border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair)}\n.ab_metric{padding-top:28px;padding-right:24px;padding-bottom:8px;padding-left:24px;border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair)}\n.ab_metric_number{font-weight:900;font-stretch:118%;font-size:clamp(48px,7vw,104px);line-height:1}\n.ab_metric_label{max-width:26ch;margin-top:10px;color:var(--_color---text--secondary)}\n@media screen and (max-width: 767px) {\n.ab_metrics{grid-template-columns:minmax(0,1fr)}\n.ab_metric{padding-left:0;border-right-style:none;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair)}\n}\n"
}