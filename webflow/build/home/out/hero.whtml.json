{
 "html": "<section class=\"section_hero\" id=\"hero\" aria-label=\"Intro\"><div class=\"padding-global\"><div class=\"container-large\"><div class=\"ab_hero_component\"><div class=\"ab_planet is-hero-giant\" data-planet=\"gas\" data-seed=\"3\" data-drag=\"\" data-colors=\"#24183f,#4b3380,#c28ac0,#3a2f6b,#f0b48a\" data-ring=\"#eadbc6,#b99c88,#6d5a7a\" data-tilt=\"-16\" data-spin=\"70\" data-glow=\"rgba(124,92,255,.35)\" data-label=\"Ringed gas giant\"></div><div class=\"ab_planet is-hero-moon\" data-planet=\"rocky\" data-seed=\"7\" data-drag=\"\" data-colors=\"#5b544c,#8e8272,#3b352f\" data-spin=\"30\" data-label=\"Rocky moon\"></div><div class=\"ab_planet is-hero-ice\" data-planet=\"ice\" data-seed=\"11\" data-drag=\"\" data-colors=\"#e3f2ff,#9cc3ee,#5a7fb8\" data-spin=\"50\" data-glow=\"rgba(140,190,255,.35)\" data-label=\"Distant ice world\"></div><div class=\"ab_hero_badge\" data-drag=\"\" data-snap=\"\" tabindex=\"0\" role=\"img\" aria-label=\"Draggable badge: design and build, established 2026\"><svg viewBox=\"0 0 120 120\" aria-hidden=\"true\"><defs><path id=\"badgeCircle\" d=\"M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0\"/></defs><g class=\"ring\"><text><textPath href=\"#badgeCircle\" textLength=\"286\" lengthAdjust=\"spacing\">Design + Build · Est. 2026 · Webflow ·</textPath></text></g><circle class=\"orbitline\" cx=\"60\" cy=\"60\" r=\"28\"/><g class=\"moonorbit\"><rect class=\"moon\" x=\"85\" y=\"57\" width=\"6\" height=\"6\"/></g><rect class=\"core\" x=\"50\" y=\"50\" width=\"20\" height=\"20\"/></svg></div><div class=\"ab_hero_sat\" id=\"sat\" tabindex=\"0\" aria-label=\"Satellite. Please do not drag it.\"><div class=\"ab_hero_sat-body\"><svg viewBox=\"0 0 96 54\" aria-hidden=\"true\"><g stroke=\"#9fb8ff\" stroke-width=\".8\"><rect x=\"2\" y=\"17\" width=\"30\" height=\"20\" fill=\"#1e2c63\"/><path d=\"M12 17v20M22 17v20M2 27h30\"/><rect x=\"64\" y=\"17\" width=\"30\" height=\"20\" fill=\"#1e2c63\"/><path d=\"M74 17v20M84 17v20M64 27h30\"/></g><path d=\"M32 27h8M56 27h8\" stroke=\"#c9c7c0\" stroke-width=\"1.5\"/><rect x=\"40\" y=\"16\" width=\"16\" height=\"22\" fill=\"#e9e6dd\" stroke=\"#fff\" stroke-width=\".8\"/><rect x=\"40\" y=\"16\" width=\"16\" height=\"5\" fill=\"#c9a66b\"/><path d=\"M48 16V6M44 4a4 4 0 0 1 8 0\" stroke=\"#c9c7c0\" stroke-width=\"1.2\" fill=\"none\"/><circle class=\"beacon\" cx=\"48\" cy=\"44\" r=\"2.2\"/></svg></div><div class=\"ab_hero_sat-label\">DO NOT DRAG</div></div><div class=\"ab_hero_meta text-style-mono\"><div>Angelino Barajas · Webflow designer + developer</div><div><span class=\"text-color-signal\">↗ Drag anything</span> · <span id=\"vpSize\">1440 × 900</span></div></div><h1 class=\"ab_hero_title heading-style-display\" id=\"heroTitle\">Websites with gravity.</h1><div class=\"ab_hero_bottom\"><p class=\"ab_hero_lede text-size-lede\">I design and build Webflow sites with the parts people remember: live globes, interactive maps, and interactions you can grab.</p><div class=\"ab_hero_cta\"><a class=\"button is-primary\" href=\"#work\" data-magnetic=\"\"><span class=\"ab_button-shine\"></span><span class=\"ab_button-label\">See the work</span><span class=\"ab_button-arrow\" aria-hidden=\"true\">↓</span></a><a class=\"button is-ghost\" href=\"#launch\" data-magnetic=\"\"><span class=\"ab_button-label\">Start a project</span></a></div></div></div></div></div></section>",
 "css": ".section_hero{position:relative}\n.ab_hero_component{position:relative;display:flex;flex-direction:column;justify-content:flex-end;min-height:min(900px,100svh);padding-top:clamp(130px,16vw,190px);padding-bottom:clamp(60px,8vw,110px)}\n.ab_planet.is-hero-giant{width:clamp(110px,17vw,250px);right:calc(clamp(110px,17vw,250px) * 0.7);top:clamp(150px,20vw,230px)}\n.ab_planet.is-hero-moon{width:clamp(38px,4vw,62px);right:clamp(150px,26vw,430px);top:clamp(420px,40vw,560px)}\n.ab_planet.is-hero-ice{width:30px;left:clamp(20px,40vw,600px);top:clamp(96px,9vw,120px)}\n.ab_hero_badge{position:absolute;z-index:4;left:clamp(10px,50vw,740px);top:clamp(92px,8vw,118px);width:108px;height:108px;color:var(--_color---brand--signal);cursor:grab;touch-action:none;user-select:none}\n.ab_hero_sat{position:absolute;z-index:4;right:clamp(24px,6vw,140px);top:clamp(400px,33vw,560px);display:flex;flex-direction:column;align-items:center;grid-row-gap:4px;grid-column-gap:4px;cursor:grab;touch-action:none;user-select:none}\n.ab_hero_sat-body{width:96px;height:54px}\n.ab_hero_sat-label{font-size:9px;letter-spacing:0.14em;line-height:1.6;color:var(--_color---text--tertiary);white-space:nowrap;opacity:0.7;transition:color 200ms ease,opacity 200ms ease}\n.ab_hero_meta{position:relative;z-index:3;display:flex;justify-content:space-between;flex-wrap:wrap;grid-row-gap:16px;grid-column-gap:16px;margin-bottom:28px;color:var(--_color---text--tertiary)}\n.ab_hero_title{position:relative;z-index:4;display:flex;flex-wrap:wrap;grid-column-gap:0.22em;pointer-events:none}\n.ab_hero_bottom{position:relative;z-index:4;display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;grid-row-gap:32px;grid-column-gap:32px;margin-top:40px}\n.ab_hero_lede{max-width:46ch;color:var(--_color---text--secondary)}\n.ab_hero_cta{display:flex;flex-wrap:wrap;grid-row-gap:14px;grid-column-gap:14px}\n@media screen and (max-width: 767px) {\n.ab_hero_badge{display:none}\n}\n"
}