{
 "html": "<section class=\"section_work\" id=\"work\" data-frame=\"work\" aria-labelledby=\"work-h\"><span class=\"ab_frame-label\" data-frame-label=\"\" aria-hidden=\"true\">▢ work</span><div class=\"padding-global\"><div class=\"container-large\"><div class=\"padding-section-large\"><div class=\"ab_section-head\"><div class=\"text-style-eyebrow\">/work · <span id=\"projCount\">3</span> flagship builds</div><h2 class=\"heading-style-h2\" id=\"work-h\" data-split=\"\">Selected <span class=\"t-outline\">work</span></h2><p class=\"ab_section-lede text-size-lede\">A working board, the way I actually design. Drag the board to pan, drag a frame to move it, click a frame to open the case study.</p></div><div class=\"ab_board_component\" id=\"board\"><div class=\"ab_board_top text-style-mono\"><div><span class=\"ab_board_file\">angelino-portfolio.fig</span> / Page 1</div><div id=\"boardCoords\">X 0 · Y 0</div></div><aside class=\"ab_board_layers text-style-mono\" id=\"layers\" aria-label=\"Layers\"><div class=\"ab_board_layers-title\">Layers</div></aside><div class=\"ab_board_viewport\" id=\"viewport\"><div class=\"ab_board_world\" id=\"world\"><div class=\"ab_board_frame is-slot\" data-selectable=\"\" data-slug=\"next-mission\" data-name=\"Next mission\" data-w=\"420\" data-h=\"230\" data-size=\"Auto\"><span class=\"ab_board_fname\">next-mission</span><div class=\"ab_board_frame-inner is-slot\"><div class=\"ab_board_slot-tag text-style-mono\">SLOT OPEN · <span data-bind=\"availability-short\">Q4 2026</span></div><div class=\"ab_board_ftitle\">Your project here</div><div class=\"ab_board_fsub\">Next frame on the board.</div></div></div></div><div class=\"ab_board_cursor\" id=\"fakeCursor\" aria-hidden=\"true\"><svg width=\"18\" height=\"22\" viewBox=\"0 0 18 22\"><path d=\"M1 1 L1 18 L6 13.5 L9.5 21 L12.5 19.5 L9 12.5 L16 12.5 Z\" fill=\"#FF6A3D\" stroke=\"#07080D\" stroke-width=\"1.2\"/></svg><span class=\"ab_board_cursor-name\">Angelino</span></div><div class=\"ab_board_cursor is-you\" id=\"youTag\" aria-hidden=\"true\"><svg width=\"18\" height=\"22\" viewBox=\"0 0 18 22\"><path d=\"M1 1 L1 18 L6 13.5 L9.5 21 L12.5 19.5 L9 12.5 L16 12.5 Z\" fill=\"#4C8DFF\" stroke=\"#fff\" stroke-width=\"1.2\"/></svg><span class=\"ab_board_cursor-name is-you\">You</span></div></div><div class=\"ab_board_ui\"><div class=\"ab_board_minimap\" id=\"minimap\" aria-hidden=\"true\"><div class=\"ab_board_mv\" id=\"mv\"></div></div><div class=\"ab_board_zoom\"><button type=\"button\" class=\"ab_board_zoom-btn\" id=\"zOut\" aria-label=\"Zoom out\">−</button><span class=\"ab_board_zoom-pct\" id=\"zPct\">100%</span><button type=\"button\" class=\"ab_board_zoom-btn\" id=\"zIn\" aria-label=\"Zoom in\">+</button><button type=\"button\" class=\"ab_board_zoom-btn is-fit\" id=\"zFit\" aria-label=\"Fit all frames\">FIT</button></div></div></div><div class=\"ab_board_help text-style-mono\"><div>Pinch or Ctrl + scroll to zoom · Layers panel jumps to a frame</div><div>New CMS projects appear on the board automatically</div></div><div class=\"ab_work-all\"><a class=\"button is-ghost\" href=\"/work\" data-magnetic=\"\"><span class=\"ab_button-label\">All missions</span><span class=\"ab_button-arrow\" aria-hidden=\"true\">→</span></a><div class=\"ab_work-all-note text-style-mono\">The full archive · filter by discipline</div></div></div></div></div></section>",
 "css": ".ab_frame-label{position:absolute;top:22px;left:var(--_spacing---layout--gutter);z-index:3;font-size:11px;letter-spacing:0.04em;color:rgba(138,143,163,0.55);white-space:nowrap;pointer-events:none;transition:color 200ms ease}\n.ab_section-head{position:relative;z-index:3;display:flex;flex-direction:column;grid-row-gap:18px;grid-column-gap:18px;margin-bottom:clamp(32px,5vw,56px)}\n.ab_section-lede{max-width:58ch;color:var(--_color---text--secondary)}\n.section_work{position:relative}\n.ab_board_component{position:relative;z-index:3;height:clamp(480px,72vh,700px);border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);overflow-x:hidden;overflow-y:hidden;background-color:var(--_color---neutral--void);background-image:radial-gradient(circle,rgba(255,255,255,0.09) 1px,transparent 1.3px);background-size:24px 24px;user-select:none}\n.ab_board_top{position:absolute;left:0;right:0;top:0;z-index:8;height:40px;display:flex;align-items:center;justify-content:space-between;padding-left:14px;padding-right:14px;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);background-color:var(--_color---neutral--deep);color:var(--_color---text--tertiary)}\n.ab_board_file{color:var(--_color---text--primary)}\n.ab_board_layers{position:absolute;left:0;top:40px;bottom:0;z-index:8;width:210px;display:flex;flex-direction:column;grid-row-gap:4px;grid-column-gap:4px;padding-top:14px;padding-right:10px;padding-bottom:14px;padding-left:10px;background-color:var(--_color---neutral--deep);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair)}\n.ab_board_layers-title{padding-top:4px;padding-right:8px;padding-bottom:10px;padding-left:8px;color:var(--_color---text--tertiary);text-transform:uppercase;letter-spacing:0.1em;font-size:11px}\n.ab_board_viewport{position:absolute;left:210px;right:0;top:40px;bottom:0;cursor:grab;touch-action:pan-y}\n.ab_board_world{position:absolute;left:0;top:0;transform-origin:0% 0%}\n.ab_board_frame{position:absolute;display:block;text-decoration:none;cursor:pointer;touch-action:none}\n.ab_board_frame.is-slot{width:420px;height:230px}\n.ab_board_fname{position:absolute;left:0;top:-22px;font-size:11px;color:var(--_color---text--tertiary)}\n.ab_board_frame-inner{position:absolute;top:0;right:0;bottom:0;left:0;overflow-x:hidden;overflow-y:hidden;display:flex;flex-direction:column;justify-content:flex-end;padding-top:24px;padding-right:24px;padding-bottom:24px;padding-left:24px;transition:box-shadow 300ms ease}\n.ab_board_frame-inner.is-slot{justify-content:center;align-items:flex-start;grid-row-gap:8px;grid-column-gap:8px;border-top-width:1px;border-top-style:dashed;border-top-color:var(--_color---neutral--hair-strong);border-right-width:1px;border-right-style:dashed;border-right-color:var(--_color---neutral--hair-strong);border-bottom-width:1px;border-bottom-style:dashed;border-bottom-color:var(--_color---neutral--hair-strong);border-left-width:1px;border-left-style:dashed;border-left-color:var(--_color---neutral--hair-strong);background-color:rgba(14,16,32,0.6);color:var(--_color---text--primary)}\n.ab_board_slot-tag{color:var(--_color---brand--signal)}\n.ab_board_ftitle{position:relative;font-weight:800;font-stretch:112%;font-size:26px;line-height:1.1;text-transform:uppercase}\n.ab_board_fsub{position:relative;margin-top:4px;font-size:13px;opacity:0.7}\n.ab_board_cursor{position:absolute;left:0;top:0;z-index:7;display:flex;align-items:flex-start;grid-row-gap:2px;grid-column-gap:2px;pointer-events:none}\n.ab_board_cursor.is-you{opacity:0;transition:opacity 200ms ease}\n.ab_board_cursor-name{margin-top:16px;padding-top:3px;padding-right:7px;padding-bottom:3px;padding-left:7px;font-size:11px;white-space:nowrap;background-color:var(--_color---brand--signal);color:var(--_color---brand--on-signal)}\n.ab_board_cursor-name.is-you{background-color:var(--_color---ui--select);color:#fff}\n.ab_board_ui{position:absolute;right:14px;bottom:14px;z-index:8;display:flex;align-items:flex-end;grid-row-gap:8px;grid-column-gap:8px}\n.ab_board_minimap{position:relative;width:150px;height:90px;overflow-x:hidden;overflow-y:hidden;background-color:var(--_color---neutral--deep);border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair)}\n.ab_board_mv{position:absolute;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---brand--signal);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---brand--signal);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---brand--signal);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---brand--signal)}\n.ab_board_zoom{display:flex;background-color:var(--_color---neutral--deep);border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair)}\n.ab_board_zoom-btn{display:grid;align-items:center;justify-items:center;min-width:34px;height:34px;padding-top:0;padding-right:0;padding-bottom:0;padding-left:0;border-top-style:none;border-right-style:none;border-bottom-style:none;border-left-style:none;background-color:transparent;color:var(--_color---text--primary);font-size:13px;cursor:pointer}\n.ab_board_zoom-btn:hover{background-color:rgba(255,255,255,0.06)}\n.ab_board_zoom-btn.is-fit{padding-left:10px;padding-right:10px;font-size:12px;letter-spacing:0.06em}\n.ab_board_zoom-pct{display:grid;align-items:center;justify-items:center;min-width:52px;border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);font-size:12px}\n.ab_board_help{display:flex;justify-content:space-between;flex-wrap:wrap;grid-row-gap:16px;grid-column-gap:16px;margin-top:14px;color:var(--_color---text--tertiary)}\n.ab_work-all{position:relative;z-index:3;display:flex;align-items:center;flex-wrap:wrap;grid-row-gap:16px;grid-column-gap:16px;margin-top:28px}\n.ab_work-all-note{color:var(--_color---text--tertiary)}\n@media screen and (max-width: 767px) {\n.ab_board_layers{display:none}\n.ab_board_viewport{left:0}\n.ab_board_minimap{display:none}\n}\n"
}