{
 "html": "<div class=\"ab_planner_top text-style-mono\"><div class=\"ab_planner_status\"><span class=\"ab_planner_led\" aria-hidden=\"true\"></span>Mission planner</div><div id=\"plId\">MSN-07 · unassigned</div></div>",
 "css": ".ab_planner_wrap{margin-bottom:0}\n.ab_planner{position:relative;display:flex;flex-direction:column;grid-row-gap:18px;grid-column-gap:18px;padding-top:18px;padding-right:18px;padding-bottom:22px;padding-left:18px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair-strong);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair-strong);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair-strong);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair-strong);background-image:linear-gradient(180deg,rgba(22,26,46,0.92),rgba(10,11,20,0.94));box-shadow:0 40px 90px -40px rgba(0,0,0,0.9)}\n.ab_planner_top{display:flex;justify-content:space-between;align-items:center;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--_color---text--tertiary)}\n.ab_planner_status{display:flex;align-items:center;grid-row-gap:8px;grid-column-gap:8px;color:var(--_color---text--primary)}\n.ab_planner_led{width:7px;height:7px;background-color:var(--_color---status--live);box-shadow:0 0 10px #3BE38A}\n.ab_planner_viz{position:relative;aspect-ratio:560/190;overflow-x:hidden;overflow-y:hidden;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:#05060A;background-image:radial-gradient(90% 120% at 80% 40%,rgba(124,92,255,0.12),transparent 60%)}\n.ab_planner_layer{position:absolute;top:0;right:0;bottom:0;left:0;z-index:0}\n.ab_planner_layer.is-top{z-index:2;pointer-events:none}\n.ab_planner_bodies{position:absolute;top:0;right:0;bottom:0;left:0;z-index:1}\n.ab_planet.is-planner-earth{left:6.43%;top:68.42%;width:7.14%}\n.ab_planner_dest{position:absolute;left:50%;top:40%;width:7%;aspect-ratio:1;transform:translate(-50%,-50%)}\n.ab_planet.is-planner-dest{top:0;right:0;bottom:0;left:0;width:100%;opacity:0;transition:opacity 500ms ease}\n.ab_planner_read{position:absolute;left:10px;right:10px;bottom:8px;z-index:3;overflow-x:hidden;overflow-y:hidden;font-size:10.5px;letter-spacing:0.06em;text-transform:uppercase;white-space:nowrap;text-overflow:ellipsis;color:var(--_color---text--tertiary)}\n.ab_planner_go{display:flex;flex-wrap:wrap;align-items:center;grid-row-gap:18px;grid-column-gap:28px;margin-top:4px;padding-top:14px;padding-right:0;padding-bottom:10px;padding-left:0;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair)}\n.ab_planner_sent{padding-top:clamp(24px,4vw,48px);padding-right:clamp(24px,4vw,48px);padding-bottom:clamp(24px,4vw,48px);padding-left:clamp(24px,4vw,48px);border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair-strong);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair-strong);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair-strong);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair-strong);background-color:rgba(7,8,13,0.94);text-align:left;color:var(--_color---text--primary)}\n.ab_planner_sent-inner{display:flex;flex-direction:column;justify-content:center;grid-row-gap:12px;grid-column-gap:12px;min-height:420px}\n.ab_planner_sent-tag{font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:var(--_color---status--live)}\n.ab_planner_sent-title{font-weight:900;font-stretch:118%;font-size:clamp(34px,4vw,56px);line-height:0.95;text-transform:uppercase}\n.ab_planner_sent-text{max-width:44ch;color:var(--_color---text--secondary)}\n.ab_planner_fail{margin-top:12px;padding-top:12px;padding-right:16px;padding-bottom:12px;padding-left:16px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---status--alert);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---status--alert);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---status--alert);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---status--alert);background-color:rgba(255,75,58,0.12);color:var(--_color---text--primary)}\n"
}