{
 "html": "<section class=\"section_hub-map theme-light\" id=\"trajectory\" data-frame=\"trajectory-planner\" aria-labelledby=\"map-h\"><span class=\"ab_frame-label\" data-frame-label=\"\" aria-hidden=\"true\">▢ trajectory-planner</span><div class=\"ab_light-glow is-top\" aria-hidden=\"true\"></div><div class=\"ab_light-glow is-bottom\" aria-hidden=\"true\"></div><div class=\"ab_light-bg\" aria-hidden=\"true\"></div><div class=\"padding-global\"><div class=\"container-large\"><div class=\"ab_hub-map_head\"><div class=\"ab_section-head is-flush\"><div class=\"text-style-eyebrow\">/trajectory · <span data-hub-routes=\"\">10</span> transfer orbits</div><h2 class=\"heading-style-h2\" id=\"map-h\" data-split=\"\">Plot a <span class=\"t-outline\">trajectory</span></h2></div><div class=\"ab_hub-map_side\"><p class=\"text-size-lede\">Most missions stop at more than one planet. Set your main destination, add up to two stops, and send the whole trajectory to the flight planner.</p><div class=\"ab_hub-steps\" data-hub-steps=\"\"><div class=\"ab_hub-step\" data-step=\"1\"><span class=\"ab_hub-step_n\">1</span>Main destination</div><div class=\"ab_hub-step\" data-step=\"2\"><span class=\"ab_hub-step_n\">2</span>Stops · up to 2</div><div class=\"ab_hub-step\" data-step=\"3\"><span class=\"ab_hub-step_n\">3</span>Launch</div></div></div></div></div></div><div class=\"ab_hub-plan\"><div class=\"ab_hub-map\" data-hub-map=\"\" aria-label=\"Trajectory map\"></div><aside class=\"ab_hub-planner\" data-selectable=\"\" data-name=\"Panel / trajectory\" data-hub-planner=\"\" aria-live=\"polite\"></aside></div></section>",
 "css": ".section_hub-map{position:relative;z-index:1;padding-bottom:clamp(64px,8vw,110px)}\n.ab_hub-map_head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;grid-row-gap:20px;grid-column-gap:48px}\n.ab_hub-map_side{display:flex;flex-direction:column;grid-row-gap:18px;grid-column-gap:18px;max-width:52ch}\n.ab_hub-steps{display:flex;flex-wrap:wrap;grid-row-gap:8px;grid-column-gap:8px}\n.ab_hub-step{display:inline-flex;align-items:center;grid-row-gap:8px;grid-column-gap:8px;padding-top:6px;padding-right:12px;padding-bottom:6px;padding-left:6px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair-strong);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair-strong);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair-strong);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair-strong);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--_color---text--tertiary)}\n.ab_hub-step_n{display:grid;width:20px;height:20px;align-items:center;justify-items:center;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair-strong);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair-strong);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair-strong);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair-strong);font-size:11px;font-weight:600}\n.ab_hub-plan{position:relative;display:grid;grid-template-columns:minmax(0,1fr) min(440px,34vw);align-items:start;grid-row-gap:clamp(20px,3vw,44px);grid-column-gap:clamp(20px,3vw,44px);margin-top:clamp(28px,4vw,52px);padding-right:var(--_spacing---layout--gutter)}\n.ab_hub-map{position:relative;height:clamp(420px,40vw,600px)}\n.ab_hub-planner{position:relative;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:var(--_color---neutral--panel)}\n@media screen and (max-width: 991px) {\n.ab_hub-plan{grid-template-columns:minmax(0,1fr);padding-left:var(--_spacing---layout--gutter)}\n}\n@media screen and (max-width: 767px) {\n.ab_hub-map{height:400px}\n}\n"
}