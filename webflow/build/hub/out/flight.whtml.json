{
 "html": "<section class=\"section_hub-flight\" id=\"flight\" data-frame=\"flight-plan\" aria-labelledby=\"flight-h\" data-hub-flight=\"\"><span class=\"ab_frame-label\" data-frame-label=\"\" aria-hidden=\"true\">▢ flight-plan</span><div class=\"padding-global\"><div class=\"container-large\"><div class=\"ab_hub-flight_head\"><div class=\"ab_section-head is-flush\"><div class=\"text-style-eyebrow\">/flight plan · <span data-fl=\"codes\">WFD</span></div><h2 class=\"heading-style-h2 is-flight\" id=\"flight-h\">Your flight <span class=\"t-outline\">plan</span></h2><p class=\"text-size-lede ab_hub-flight_lede\" data-fl=\"lede\">Six stages, re-plotted for Website. Scroll to fly it.</p></div><div class=\"ab_hub-flight_acts\"><a class=\"button is-ghost\" href=\"#trajectory\" data-magnetic=\"\" data-fl-edit=\"\"><span class=\"ab_button-label\">Edit trajectory</span><span class=\"ab_button-arrow\" aria-hidden=\"true\">↑</span></a><a class=\"button is-ghost is-abort\" href=\"#trajectory\" data-magnetic=\"\" data-fl-abort=\"\"><span class=\"ab_button-label\">Abort mission</span><span class=\"ab_button-arrow\" aria-hidden=\"true\">✕</span></a></div></div></div></div><div class=\"ab_hub-flight_wrap\"><div class=\"ab_hub-flight_hud\" aria-live=\"polite\"><span class=\"ab_hub-flight_n\" data-fl=\"n\">T−6</span><span data-fl=\"l\">On the pad</span></div><div class=\"ab_hub-flight_track\" data-fl-track=\"\"><div class=\"ab_hub-wp\" data-wp=\"0\" data-stage=\"Pre-flight\"><span class=\"ab_hub-wp_node\" aria-hidden=\"true\"></span><article class=\"ab_hub-wp_card\"><div class=\"ab_hub-wp_top\"><span><span class=\"ab_hub-wp_code\">T−5</span> · Pre-flight</span><span>1 / 6</span></div><h3 class=\"ab_hub-wp_title\">Discovery call</h3><p class=\"ab_hub-wp_text\">A call to learn your goals, your audience and what a win looks like.</p><div class=\"ab_hub-wp_legs\" data-fl-legs=\"\"></div><div class=\"ab_hub-wp_meta\"><div><div class=\"ab_hub-wp_k\">You get</div><div class=\"ab_hub-wp_v\">Creative brief</div></div><div><div class=\"ab_hub-wp_k\">Your part</div><div class=\"ab_hub-wp_v\">Share your goals, sites you like and any brand files.</div></div></div><a class=\"ab_hub-wp_flown\" href=\"/work\" data-fl-flown=\"\" data-flown-what=\"the brief\">See the brief →</a></article></div><div class=\"ab_hub-wp\" data-wp=\"1\" data-stage=\"Flight plan\"><span class=\"ab_hub-wp_node\" aria-hidden=\"true\"></span><article class=\"ab_hub-wp_card\"><div class=\"ab_hub-wp_top\"><span><span class=\"ab_hub-wp_code\">T−4</span> · Flight plan</span><span>2 / 6</span></div><h3 class=\"ab_hub-wp_title\">Alignment</h3><p class=\"ab_hub-wp_text\">Scope, timeline and content plan agreed before any pixels move.</p><div class=\"ab_hub-wp_legs\" data-fl-legs=\"\"></div><div class=\"ab_hub-wp_meta\"><div><div class=\"ab_hub-wp_k\">You get</div><div class=\"ab_hub-wp_v\">Plan + dates</div></div><div><div class=\"ab_hub-wp_k\">Your part</div><div class=\"ab_hub-wp_v\">Sign off on scope and dates.</div></div></div><a class=\"ab_hub-wp_flown\" href=\"/work\" data-fl-flown=\"\" data-flown-what=\"the plan\">See the plan →</a></article></div><div class=\"ab_hub-wp\" data-wp=\"2\" data-stage=\"Payload\"><span class=\"ab_hub-wp_node\" aria-hidden=\"true\"></span><article class=\"ab_hub-wp_card\"><div class=\"ab_hub-wp_top\"><span><span class=\"ab_hub-wp_code\">T−3</span> · Payload</span><span>3 / 6</span></div><h3 class=\"ab_hub-wp_title\">Brand + assets</h3><p class=\"ab_hub-wp_text\">Logo, color, type, content and data, gathered or made, then turned into tokens.</p><div class=\"ab_hub-wp_legs\" data-fl-legs=\"\"></div><div class=\"ab_hub-wp_meta\"><div><div class=\"ab_hub-wp_k\">You get</div><div class=\"ab_hub-wp_v\">Brand kit + tokens</div></div><div><div class=\"ab_hub-wp_k\">Your part</div><div class=\"ab_hub-wp_v\">Send what you have, or tell me to make it.</div></div></div><a class=\"ab_hub-wp_flown\" href=\"/work\" data-fl-flown=\"\" data-flown-what=\"the brand kit\">See the brand kit →</a></article></div><div class=\"ab_hub-wp\" data-wp=\"3\" data-stage=\"Test flight\"><span class=\"ab_hub-wp_node\" aria-hidden=\"true\"></span><article class=\"ab_hub-wp_card\"><div class=\"ab_hub-wp_top\"><span><span class=\"ab_hub-wp_code\">T−2</span> · Test flight</span><span>4 / 6</span></div><h3 class=\"ab_hub-wp_title\">Prototype</h3><p class=\"ab_hub-wp_text\">The key pieces, working and clickable, reviewed together before the build.</p><div class=\"ab_hub-wp_legs\" data-fl-legs=\"\"></div><div class=\"ab_hub-wp_meta\"><div><div class=\"ab_hub-wp_k\">You get</div><div class=\"ab_hub-wp_v\">Clickable prototype</div></div><div><div class=\"ab_hub-wp_k\">Your part</div><div class=\"ab_hub-wp_v\">Two rounds of feedback, live or async.</div></div></div><a class=\"ab_hub-wp_flown\" href=\"/work\" data-fl-flown=\"\" data-flown-what=\"the prototype\">See the prototype →</a></article></div><div class=\"ab_hub-wp\" data-wp=\"4\" data-stage=\"Assembly\"><span class=\"ab_hub-wp_node\" aria-hidden=\"true\"></span><article class=\"ab_hub-wp_card\"><div class=\"ab_hub-wp_top\"><span><span class=\"ab_hub-wp_code\">T−1</span> · Assembly</span><span>5 / 6</span></div><h3 class=\"ab_hub-wp_title\">Build</h3><p class=\"ab_hub-wp_text\">The real thing: built, wired to your content and tested on real devices.</p><div class=\"ab_hub-wp_legs\" data-fl-legs=\"\"></div><div class=\"ab_hub-wp_meta\"><div><div class=\"ab_hub-wp_k\">You get</div><div class=\"ab_hub-wp_v\">Staging link</div></div><div><div class=\"ab_hub-wp_k\">Your part</div><div class=\"ab_hub-wp_v\">Load content and test on your own devices.</div></div></div><a class=\"ab_hub-wp_flown\" href=\"/work\" data-fl-flown=\"\" data-flown-what=\"the build\">See the build →</a></article></div><div class=\"ab_hub-wp\" data-wp=\"5\" data-stage=\"Launch\"><span class=\"ab_hub-wp_node\" aria-hidden=\"true\"></span><article class=\"ab_hub-wp_card\"><div class=\"ab_hub-wp_top\"><span><span class=\"ab_hub-wp_code\">T−0</span> · Launch</span><span>6 / 6</span></div><h3 class=\"ab_hub-wp_title\">Deploy</h3><p class=\"ab_hub-wp_text\">Go live, connect analytics and hand over a guide so your team owns it.</p><div class=\"ab_hub-wp_legs\" data-fl-legs=\"\"></div><div class=\"ab_hub-wp_meta\"><div><div class=\"ab_hub-wp_k\">You get</div><div class=\"ab_hub-wp_v\">Live + handoff</div></div><div><div class=\"ab_hub-wp_k\">Your part</div><div class=\"ab_hub-wp_v\">Celebrate. Then tell people.</div></div></div><a class=\"ab_hub-wp_flown\" href=\"/work\" data-fl-flown=\"\" data-flown-what=\"the live result\">See the live result →</a></article></div></div></div></section>",
 "css": ".section_hub-flight{position:relative;overflow-x:hidden;overflow-y:hidden;padding-top:clamp(84px,9vh,110px);padding-bottom:clamp(40px,5vw,70px)}\n.ab_hub-flight_head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;grid-row-gap:14px;grid-column-gap:40px}\n.heading-style-h2.is-flight{font-size:clamp(36px,4.2vw,64px)}\n.ab_hub-flight_lede{max-width:52ch;margin-top:4px;font-size:clamp(15px,1.2vw,17px)}\n.ab_hub-flight_acts{display:flex;flex-grow:0;flex-shrink:0;flex-basis:auto;flex-wrap:wrap;grid-row-gap:10px;grid-column-gap:10px;margin-left:auto}\n.button.is-ghost.is-abort{position:relative}\n.ab_hub-flight_wrap{position:relative;margin-top:clamp(18px,2.4vw,30px)}\n.ab_hub-flight_hud{position:absolute;right:var(--_spacing---layout--gutter);top:-4px;z-index:6;display:flex;align-items:baseline;grid-row-gap:12px;grid-column-gap:12px;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--_color---text--tertiary)}\n.ab_hub-flight_n{font-size:clamp(34px,3.4vw,52px);font-weight:900;line-height:1;letter-spacing:-0.03em;color:var(--_color---text--primary)}\n.ab_hub-flight_track{position:relative;height:clamp(480px,calc(100vh - 230px),700px)}\n.ab_hub-wp{position:absolute;left:0;top:150px;z-index:3;width:clamp(290px,24vw,350px)}\n.ab_hub-wp_node{position:absolute;left:48px;top:-40px;z-index:4;width:16px;height:16px;margin-top:-8px;margin-left:-8px;border-top-width:2px;border-top-style:solid;border-top-color:var(--_color---neutral--hair-strong);border-right-width:2px;border-right-style:solid;border-right-color:var(--_color---neutral--hair-strong);border-bottom-width:2px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair-strong);border-left-width:2px;border-left-style:solid;border-left-color:var(--_color---neutral--hair-strong);background-color:var(--_color---neutral--void)}\n.ab_hub-wp_card{position:relative;padding-top:16px;padding-right:16px;padding-bottom:14px;padding-left:16px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:rgba(14,16,32,0.82)}\n.ab_hub-wp_top{display:flex;justify-content:space-between;grid-row-gap:10px;grid-column-gap:10px;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--_color---text--tertiary)}\n.ab_hub-wp_code{color:var(--_color---brand--signal);font-weight:500}\n.ab_hub-wp_title{margin-top:8px;margin-bottom:0;font-size:clamp(20px,1.8vw,26px);font-weight:800;line-height:1;text-transform:uppercase}\n.ab_hub-wp_text{margin-top:6px;margin-bottom:0;font-size:14.5px;color:var(--_color---text--secondary)}\n.ab_hub-wp_legs{position:relative}\n.ab_hub-wp_meta{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);grid-row-gap:8px;grid-column-gap:8px;margin-top:10px}\n.ab_hub-wp_k{font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:var(--_color---text--tertiary)}\n.ab_hub-wp_v{margin-top:2px;font-size:13px;color:var(--_color---text--primary)}\n.ab_hub-wp_flown{display:inline-flex;align-items:center;grid-row-gap:8px;grid-column-gap:8px;margin-top:10px;font-size:10.5px;letter-spacing:0.08em;text-transform:uppercase;color:var(--_color---text--tertiary);text-decoration:none}\n.ab_hub-wp_flown:hover{color:var(--_color---brand--signal)}\n"
}