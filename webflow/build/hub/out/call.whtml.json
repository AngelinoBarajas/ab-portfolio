{
 "html": "<section class=\"section_hub-call\" data-frame=\"final-call\" aria-labelledby=\"call-h\"><span class=\"ab_frame-label\" data-frame-label=\"\" aria-hidden=\"true\">▢ final-call</span><div class=\"padding-global\"><div class=\"container-large\"><div class=\"ab_mon is-call\"><div class=\"ab_hub-call_row\" data-hub-call=\"\" aria-label=\"Mission AB-09, custom charter, any transfer, orbit to be decided, on request\"></div></div><div class=\"ab_hub-call_body\"><h2 class=\"heading-style-h2\" id=\"call-h\" data-split=\"\">Not on the <span class=\"t-outline\">manifest?</span></h2><div class=\"ab_hub-call_copy\"><p class=\"text-size-lede\">Custom charters launch too. Plot it on the star chart, or tell me where you’re headed.</p><div class=\"ab_hub-call_btns\"><a class=\"button is-ghost\" href=\"/process#chart\" data-magnetic=\"\"><span class=\"ab_button-label\">Plot it with me</span><span class=\"ab_button-arrow\" aria-hidden=\"true\">→</span></a><a class=\"button is-primary\" href=\"/#launch\" data-magnetic=\"\"><span class=\"ab_button-shine\"></span><span class=\"ab_button-label\">Book a call</span><span class=\"ab_button-arrow\" aria-hidden=\"true\">→</span></a></div></div></div></div></div></section>",
 "css": ".section_hub-call{position:relative;padding-top:clamp(44px,5vw,72px);padding-bottom:clamp(56px,6vw,90px)}\n.ab_mon.is-call{display:inline-block;max-width:100%;padding-top:10px;padding-right:10px;padding-bottom:10px;padding-left:10px}\n.ab_hub-call_row{position:relative;display:flex;align-items:center;overflow-x:hidden;overflow-y:hidden;padding-top:12px;padding-right:16px;padding-bottom:12px;padding-left:16px;background-color:#05060a}\n.ab_hub-call_body{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,0.8fr);align-items:end;grid-row-gap:20px;grid-column-gap:clamp(24px,4vw,64px);margin-top:clamp(24px,3vw,40px)}\n.ab_hub-call_copy{position:relative}\n.ab_hub-call_btns{display:flex;flex-wrap:wrap;grid-row-gap:12px;grid-column-gap:12px;margin-top:22px}\n@media screen and (max-width: 991px) {\n.ab_hub-call_body{grid-template-columns:minmax(0,1fr)}\n}\n@media screen and (max-width: 767px) {\n.ab_hub-call_row{flex-wrap:wrap;grid-row-gap:4px}\n}\n"
}