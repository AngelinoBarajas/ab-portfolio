{
 "html": "<section class=\"section_process-crew theme-light\" data-frame=\"crew-roles\" aria-labelledby=\"crew-h\"><span class=\"ab_frame-label\" data-frame-label=\"\" aria-hidden=\"true\">▢ crew-roles</span><div class=\"ab_light-glow is-top\" aria-hidden=\"true\"></div><div class=\"ab_light-glow is-bottom\" aria-hidden=\"true\"></div><div class=\"ab_light-bg\" aria-hidden=\"true\"></div><div class=\"padding-global\"><div class=\"container-large\"><div class=\"padding-section-medium\"><div class=\"ab_sec-h\"><div class=\"ab_section-head is-flush\"><div class=\"text-style-eyebrow\">/crew · who does what</div><h2 class=\"heading-style-h2\" id=\"crew-h\" data-split=\"\">Crew <span class=\"t-outline\">roles</span></h2></div><p class=\"ab_sec-h_lede text-size-lede\">Two seats in the cockpit. Here is who flies what, so nothing falls between them.</p></div><div class=\"ab_crew_grid\"><div class=\"ab_crew_col\" data-selectable=\"\" data-name=\"Card / mission-control\"><div class=\"ab_crew_head\"><h3 class=\"ab_crew_title\">Mission control</h3><div class=\"ab_crew_who\">Me</div></div><ul class=\"ab_crew_list\"><li class=\"ab_crew_item\"><span class=\"ab_crew_tick\" aria-hidden=\"true\"></span><span>Plan the route and keep the dates</span></li><li class=\"ab_crew_item\"><span class=\"ab_crew_tick\" aria-hidden=\"true\"></span><span>Design and build every piece</span></li><li class=\"ab_crew_item\"><span class=\"ab_crew_tick\" aria-hidden=\"true\"></span><span>Write the code and host it on GitHub</span></li><li class=\"ab_crew_item\"><span class=\"ab_crew_tick\" aria-hidden=\"true\"></span><span>Tell you early when something changes</span></li><li class=\"ab_crew_item\"><span class=\"ab_crew_tick\" aria-hidden=\"true\"></span><span>Hand over the keys, the guide and the files</span></li></ul></div><div class=\"ab_crew_link\" aria-hidden=\"true\"><div class=\"ab_crew_link-label\">Comms open</div></div><div class=\"ab_crew_col\" data-selectable=\"\" data-name=\"Card / crew\"><div class=\"ab_crew_head\"><h3 class=\"ab_crew_title\">Crew</h3><div class=\"ab_crew_who\">You</div></div><ul class=\"ab_crew_list\"><li class=\"ab_crew_item\"><span class=\"ab_crew_tick\" aria-hidden=\"true\"></span><span>Share the brief and the sites you like</span></li><li class=\"ab_crew_item\"><span class=\"ab_crew_tick\" aria-hidden=\"true\"></span><span>Pick one person to make the call</span></li><li class=\"ab_crew_item\"><span class=\"ab_crew_tick\" aria-hidden=\"true\"></span><span>Send content, or tell me to make it</span></li><li class=\"ab_crew_item\"><span class=\"ab_crew_tick\" aria-hidden=\"true\"></span><span>Give feedback at each checkpoint</span></li><li class=\"ab_crew_item\"><span class=\"ab_crew_tick\" aria-hidden=\"true\"></span><span>Tell people when it launches</span></li></ul></div></div><div class=\"ab_crew_comms\"><div class=\"ab_crew_comms-label\">Comms</div><div>Updates at every waypoint</div><div>A shared board you can check any time</div><div>A real person on the other end</div></div></div></div></div></section>",
 "css": ".section_process-crew{position:relative}\n.ab_crew_grid{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:stretch;grid-row-gap:clamp(18px,3vw,40px);grid-column-gap:clamp(18px,3vw,40px)}\n.ab_crew_col{padding-top:clamp(18px,2.4vw,30px);padding-right:clamp(18px,2.4vw,30px);padding-bottom:clamp(18px,2.4vw,30px);padding-left:clamp(18px,2.4vw,30px);border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:var(--_color---neutral--panel)}\n.ab_crew_head{display:flex;justify-content:space-between;align-items:baseline;grid-row-gap:12px;grid-column-gap:12px}\n.ab_crew_title{font-weight:900;font-size:clamp(24px,2.4vw,34px);line-height:1;text-transform:uppercase}\n.ab_crew_who{font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--_color---text--tertiary)}\n.ab_crew_list{margin-top:18px;margin-bottom:0;padding-left:0;list-style-type:none}\n.ab_crew_item{display:grid;grid-template-columns:22px minmax(0,1fr);grid-row-gap:10px;grid-column-gap:10px;padding-top:11px;padding-bottom:11px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);font-size:16px}\n.ab_crew_tick{width:18px;height:18px;margin-top:3px;border-top-width:1.5px;border-top-style:solid;border-top-color:var(--_color---neutral--hair-strong);border-right-width:1.5px;border-right-style:solid;border-right-color:var(--_color---neutral--hair-strong);border-bottom-width:1.5px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair-strong);border-left-width:1.5px;border-left-style:solid;border-left-color:var(--_color---neutral--hair-strong)}\n.ab_crew_link{position:relative;width:2px}\n.ab_crew_link-label{position:absolute;left:50%;top:50%;padding-top:6px;padding-right:10px;padding-bottom:6px;padding-left:10px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:var(--_color---neutral--void);font-size:10.5px;letter-spacing:0.12em;text-transform:uppercase;white-space:nowrap;color:var(--_color---text--tertiary)}\n.ab_crew_comms{display:flex;flex-wrap:wrap;align-items:center;grid-row-gap:10px;grid-column-gap:28px;margin-top:clamp(18px,2.4vw,28px);padding-top:14px;padding-right:18px;padding-bottom:14px;padding-left:18px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);font-size:12px;letter-spacing:0.06em;color:var(--_color---text--secondary)}\n.ab_crew_comms-label{font-size:11px;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;color:var(--_color---text--primary)}\n@media screen and (max-width: 767px) {\n.ab_crew_grid{grid-template-columns:minmax(0,1fr)}\n.ab_crew_link{width:auto;height:2px;margin-top:18px;margin-bottom:18px}\n}\n"
}