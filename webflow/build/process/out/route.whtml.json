{
 "html": "<section class=\"section_process-route\" id=\"route\" data-frame=\"trajectory\" aria-labelledby=\"route-h\"><span class=\"ab_frame-label\" data-frame-label=\"\" aria-hidden=\"true\">▢ trajectory</span><div class=\"padding-global\"><div class=\"container-large\"><div class=\"ab_route_head\"><div class=\"ab_sec-h\"><div class=\"ab_section-head is-flush\"><div class=\"text-style-eyebrow\">/trajectory · 6 waypoints</div><h2 class=\"heading-style-h2\" id=\"route-h\" data-split=\"\">The <span class=\"t-outline\">route</span></h2></div><p class=\"ab_sec-h_lede text-size-lede\">Scroll to fly it. Each waypoint shows what happens, what you get and what I need from you.</p></div></div></div></div><div class=\"ab_route_wrap\"><div class=\"ab_route_hud\" aria-live=\"polite\"><div class=\"ab_route_hud-n\" data-hud-n=\"\">T−6</div><div class=\"ab_route_hud-l\" data-hud-l=\"\">On the pad</div></div><div class=\"ab_route_track\" data-route-track=\"\"><div class=\"ab_route_wp\" data-wp=\"0\"><div class=\"ab_route_node\" aria-hidden=\"true\"></div><article class=\"ab_route_card\" data-selectable=\"\" data-name=\"Waypoint / pre-flight\"><div class=\"ab_route_card-top\"><div><span class=\"ab_route_card-code\">T−5</span> · Pre-flight</div><div>1 / 6</div></div><h3 class=\"ab_route_card-title\">Discovery call</h3><p class=\"ab_route_card-text\">A call to learn your goals, your audience and what a win looks like.</p><div class=\"ab_route_leg\"><div class=\"ab_route_leg-label\" data-leg-label=\"\">For Website</div><div class=\"ab_route_leg-text\" data-leg=\"\">Goals, audience and what the site has to do.</div></div><div class=\"ab_route_meta\"><div><div class=\"ab_route_meta-label\">You get</div><div class=\"ab_route_meta-value\">Creative brief</div></div><div><div class=\"ab_route_meta-label\">Your part</div><div class=\"ab_route_meta-value\">Share your goals, sites you like and any brand files.</div></div></div><a class=\"ab_route_flown\" href=\"/work/daniel-aguirre-law\" data-flown=\"\" data-flown-what=\"the brief\">See the brief · Daniel Aguirre Law →</a></article></div><div class=\"ab_route_wp\" data-wp=\"1\"><div class=\"ab_route_node\" aria-hidden=\"true\"></div><article class=\"ab_route_card\" data-selectable=\"\" data-name=\"Waypoint / flight plan\"><div class=\"ab_route_card-top\"><div><span class=\"ab_route_card-code\">T−4</span> · Flight plan</div><div>2 / 6</div></div><h3 class=\"ab_route_card-title\">Alignment</h3><p class=\"ab_route_card-text\">Scope, timeline and content plan agreed before any pixels move.</p><div class=\"ab_route_leg\"><div class=\"ab_route_leg-label\" data-leg-label=\"\">For Website</div><div class=\"ab_route_leg-text\" data-leg=\"\">Sitemap, content plan and wireframes, signed off before design.</div></div><div class=\"ab_route_meta\"><div><div class=\"ab_route_meta-label\">You get</div><div class=\"ab_route_meta-value\">Plan + dates</div></div><div><div class=\"ab_route_meta-label\">Your part</div><div class=\"ab_route_meta-value\">Sign off on scope and dates.</div></div></div><a class=\"ab_route_flown\" href=\"/work/daniel-aguirre-law\" data-flown=\"\" data-flown-what=\"the plan\">See the plan · Daniel Aguirre Law →</a></article></div><div class=\"ab_route_wp\" data-wp=\"2\"><div class=\"ab_route_node\" aria-hidden=\"true\"></div><article class=\"ab_route_card\" data-selectable=\"\" data-name=\"Waypoint / payload\"><div class=\"ab_route_card-top\"><div><span class=\"ab_route_card-code\">T−3</span> · Payload</div><div>3 / 6</div></div><h3 class=\"ab_route_card-title\">Brand + assets</h3><p class=\"ab_route_card-text\">Logo, color, type, content and data, gathered or made, then turned into tokens.</p><div class=\"ab_route_leg\"><div class=\"ab_route_leg-label\" data-leg-label=\"\">For Website</div><div class=\"ab_route_leg-text\" data-leg=\"\">Brand, copy and photos gathered, then turned into design tokens.</div></div><div class=\"ab_route_meta\"><div><div class=\"ab_route_meta-label\">You get</div><div class=\"ab_route_meta-value\">Brand kit + tokens</div></div><div><div class=\"ab_route_meta-label\">Your part</div><div class=\"ab_route_meta-value\">Send what you have, or tell me to make it.</div></div></div><a class=\"ab_route_flown\" href=\"/work/daniel-aguirre-law\" data-flown=\"\" data-flown-what=\"the brand kit\">See the brand kit · Daniel Aguirre Law →</a></article></div><div class=\"ab_route_wp\" data-wp=\"3\"><div class=\"ab_route_node\" aria-hidden=\"true\"></div><article class=\"ab_route_card\" data-selectable=\"\" data-name=\"Waypoint / test flight\"><div class=\"ab_route_card-top\"><div><span class=\"ab_route_card-code\">T−2</span> · Test flight</div><div>4 / 6</div></div><h3 class=\"ab_route_card-title\">Prototype</h3><p class=\"ab_route_card-text\">The key pieces, working and clickable, reviewed together before the build.</p><div class=\"ab_route_leg\"><div class=\"ab_route_leg-label\" data-leg-label=\"\">For Website</div><div class=\"ab_route_leg-text\" data-leg=\"\">Key pages designed in Figma and clicked through as a prototype.</div></div><div class=\"ab_route_meta\"><div><div class=\"ab_route_meta-label\">You get</div><div class=\"ab_route_meta-value\">Clickable prototype</div></div><div><div class=\"ab_route_meta-label\">Your part</div><div class=\"ab_route_meta-value\">Two rounds of feedback, live or async.</div></div></div><a class=\"ab_route_flown\" href=\"/work/daniel-aguirre-law\" data-flown=\"\" data-flown-what=\"the prototype\">See the prototype · Daniel Aguirre Law →</a></article></div><div class=\"ab_route_wp\" data-wp=\"4\"><div class=\"ab_route_node\" aria-hidden=\"true\"></div><article class=\"ab_route_card\" data-selectable=\"\" data-name=\"Waypoint / assembly\"><div class=\"ab_route_card-top\"><div><span class=\"ab_route_card-code\">T−1</span> · Assembly</div><div>5 / 6</div></div><h3 class=\"ab_route_card-title\">Build</h3><p class=\"ab_route_card-text\">The real thing: built, wired to your content and tested on real devices.</p><div class=\"ab_route_leg\"><div class=\"ab_route_leg-label\" data-leg-label=\"\">For Website</div><div class=\"ab_route_leg-text\" data-leg=\"\">Built in Webflow from the ground up: components, CMS, motion.</div></div><div class=\"ab_route_meta\"><div><div class=\"ab_route_meta-label\">You get</div><div class=\"ab_route_meta-value\">Staging link</div></div><div><div class=\"ab_route_meta-label\">Your part</div><div class=\"ab_route_meta-value\">Load content and test on your own devices.</div></div></div><a class=\"ab_route_flown\" href=\"/work/daniel-aguirre-law\" data-flown=\"\" data-flown-what=\"the build\">See the build · Daniel Aguirre Law →</a></article></div><div class=\"ab_route_wp\" data-wp=\"5\"><div class=\"ab_route_node\" aria-hidden=\"true\"></div><article class=\"ab_route_card\" data-selectable=\"\" data-name=\"Waypoint / launch\"><div class=\"ab_route_card-top\"><div><span class=\"ab_route_card-code\">T−0</span> · Launch</div><div>6 / 6</div></div><h3 class=\"ab_route_card-title\">Deploy</h3><p class=\"ab_route_card-text\">Go live, connect analytics and hand over a guide so your team owns it.</p><div class=\"ab_route_leg\"><div class=\"ab_route_leg-label\" data-leg-label=\"\">For Website</div><div class=\"ab_route_leg-text\" data-leg=\"\">QA, a Lighthouse pass, launch day and a walkthrough for your team.</div></div><div class=\"ab_route_meta\"><div><div class=\"ab_route_meta-label\">You get</div><div class=\"ab_route_meta-value\">Live + handoff</div></div><div><div class=\"ab_route_meta-label\">Your part</div><div class=\"ab_route_meta-value\">Celebrate. Then tell people.</div></div></div><a class=\"ab_route_flown\" href=\"/work/daniel-aguirre-law\" data-flown=\"\" data-flown-what=\"the live result\">See the live result · Daniel Aguirre Law →</a></article></div></div></div></section>",
 "css": ".section_process-route{position:relative;overflow-x:hidden;overflow-y:hidden;padding-top:clamp(64px,9vw,120px);padding-bottom:clamp(64px,9vw,120px)}\n.ab_route_head{position:relative}\n.ab_route_wrap{position:relative;margin-top:clamp(28px,4vw,48px)}\n.ab_route_hud{position:absolute;right:var(--_spacing---layout--gutter);top:-6px;z-index:6;display:flex;align-items:baseline;grid-row-gap:12px;grid-column-gap:12px;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--_color---text--tertiary)}\n.ab_route_hud-n{font-weight:900;font-size:clamp(34px,3.4vw,52px);line-height:1;letter-spacing:-0.03em;color:var(--_color---text--primary)}\n.ab_route_hud-l{position:relative}\n.ab_route_track{position:relative;height:clamp(600px,72vh,720px)}\n.ab_route_wp{position:absolute;left:0;top:200px;z-index:3;width:clamp(290px,24vw,350px)}\n.ab_route_node{position:absolute;left:48px;top:-100px;z-index:4;width:16px;height:16px;margin-top:-8px;margin-left:-8px;border-top-width:2px;border-top-style:solid;border-top-color:var(--_color---neutral--hair-strong);border-right-width:2px;border-right-style:solid;border-right-color:var(--_color---neutral--hair-strong);border-bottom-width:2px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair-strong);border-left-width:2px;border-left-style:solid;border-left-color:var(--_color---neutral--hair-strong);background-color:var(--_color---neutral--void)}\n.ab_route_card{position:relative;padding-top:18px;padding-right:18px;padding-bottom:16px;padding-left:18px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:var(--_color---neutral--glass)}\n.ab_route_card-top{display:flex;justify-content:space-between;grid-row-gap:10px;grid-column-gap:10px;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--_color---text--tertiary)}\n.ab_route_card-code{color:var(--_color---brand--signal);font-weight:500}\n.ab_route_card-title{margin-top:10px;font-weight:800;font-size:clamp(22px,2vw,28px);line-height:1;text-transform:uppercase}\n.ab_route_card-text{margin-top:8px;font-size:15px;color:var(--_color---text--secondary)}\n.ab_route_leg{margin-top:12px;padding-top:10px;padding-right:12px;padding-bottom:10px;padding-left:12px;border-left-width:2px;border-left-style:solid;border-left-color:var(--_color---ui--select);font-size:14.5px;color:var(--_color---text--primary)}\n.ab_route_leg-label{margin-bottom:3px;font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:var(--_color---text--tertiary)}\n.ab_route_leg-text{position:relative}\n.ab_route_meta{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);grid-row-gap:10px;grid-column-gap:10px;margin-top:12px}\n.ab_route_meta-label{font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:var(--_color---text--tertiary)}\n.ab_route_meta-value{margin-top:2px;font-size:13.5px;color:var(--_color---text--primary)}\n.ab_route_flown{display:inline-block;margin-top:12px;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;text-decoration:none;color:var(--_color---text--tertiary)}\n.ab_route_flown:hover{color:var(--_color---brand--signal)}\n@media screen and (max-width: 767px) {\n.ab_route_track{height:auto;padding-left:36px;padding-right:var(--_spacing---layout--gutter)}\n.ab_route_wp{position:relative;top:auto;width:auto;margin-bottom:22px}\n.ab_route_node{left:-34px;top:22px;margin-top:0;margin-left:0}\n.ab_route_hud{position:relative;right:auto;top:auto;margin-left:var(--_spacing---layout--gutter);margin-bottom:16px}\n}\n@media screen and (max-width: 479px) {\n.ab_route_meta{grid-template-columns:minmax(0,1fr)}\n}\n"
}