{
 "html": "<section class=\"section_process-chart\" id=\"chart\" data-frame=\"star-chart\" aria-labelledby=\"chart-h\"><span class=\"ab_frame-label\" data-frame-label=\"\" aria-hidden=\"true\">▢ star-chart</span><div class=\"padding-global\"><div class=\"container-large\"><div class=\"padding-section-medium\"><div class=\"ab_sec-h\"><div class=\"ab_section-head is-flush\"><div class=\"text-style-eyebrow\">/destinations · 8 services</div><h2 class=\"heading-style-h2\" id=\"chart-h\" data-split=\"\">Pick a <span class=\"t-outline\">destination</span></h2></div><p class=\"ab_sec-h_lede text-size-lede\">Every service is a planet. Pick one and the rest of this page re-plots the route for it.</p></div><div class=\"ab_chart_grid\"><div class=\"ab_chart\" data-chart=\"\" role=\"radiogroup\" aria-label=\"Destinations\"><div class=\"ab_chart_sun\" aria-hidden=\"true\"><div class=\"ab_chart_sun-label\">You · the brief</div></div></div><aside class=\"ab_chart_panel\" data-selectable=\"\" data-name=\"Panel / destination\" aria-live=\"polite\"><div class=\"ab_chart_panel-head\"><div>Destination locked</div><div class=\"ab_chart_panel-short\" data-dest-short=\"\">Website</div></div><div class=\"ab_chart_panel-body\"><h3 class=\"ab_chart_title\" data-dest-title=\"\"><span class=\"ab_chart_title-a\">Webflow</span> <span class=\"ab_chart_title-b t-outline\">development</span></h3><p class=\"ab_chart_sum\" data-dest-sum=\"\">Sites your team can actually edit. Planned, designed in Figma and built in Webflow from the ground up.</p><div class=\"ab_chart_plan\" data-dest-plan=\"\"><div class=\"ab_chart_plan-item\"><div class=\"ab_chart_plan-no\">Stage 01</div><div class=\"ab_chart_plan-name\">Discovery</div></div><div class=\"ab_chart_plan-item\"><div class=\"ab_chart_plan-no\">Stage 02</div><div class=\"ab_chart_plan-name\">Plan + design</div></div><div class=\"ab_chart_plan-item\"><div class=\"ab_chart_plan-no\">Stage 03</div><div class=\"ab_chart_plan-name\">Build</div></div><div class=\"ab_chart_plan-item\"><div class=\"ab_chart_plan-no\">Stage 04</div><div class=\"ab_chart_plan-name\">Launch + handoff</div></div></div><div class=\"ab_chart_actions\"><a class=\"button is-ghost\" href=\"/services/webflow-development\" data-magnetic=\"\" data-dest-link=\"\"><span class=\"ab_button-label\">Service page</span><span class=\"ab_button-arrow\" aria-hidden=\"true\">→</span></a><a class=\"button is-primary\" href=\"#route\" data-magnetic=\"\"><span class=\"ab_button-shine\"></span><span class=\"ab_button-label\">Plot the course</span><span class=\"ab_button-arrow\" aria-hidden=\"true\">↓</span></a></div></div></aside></div></div></div></div></section>",
 "css": ".section_process-chart{position:relative}\n.ab_chart_grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,0.75fr);align-items:center;grid-row-gap:clamp(24px,4vw,64px);grid-column-gap:clamp(24px,4vw,64px)}\n.ab_chart{position:relative;width:100%;max-width:760px;aspect-ratio:1;margin-left:auto;margin-right:auto;border-top-left-radius:50%;border-top-right-radius:50%;border-bottom-right-radius:50%;border-bottom-left-radius:50%}\n.ab_chart_sun{position:absolute;left:43.5%;top:43.5%;z-index:2;width:13%;aspect-ratio:1;border-top-left-radius:50%;border-top-right-radius:50%;border-bottom-right-radius:50%;border-bottom-left-radius:50%;background-color:var(--_color---brand--signal)}\n.ab_chart_sun-label{position:absolute;left:50%;top:calc(100% + 10px);transform:translateX(-50%);font-size:10.5px;letter-spacing:0.1em;text-transform:uppercase;white-space:nowrap;color:var(--_color---text--tertiary)}\n.ab_chart_panel{position:relative;display:block;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:var(--_color---neutral--glass)}\n.ab_chart_panel-head{display:flex;justify-content:space-between;align-items:center;padding-top:10px;padding-right:16px;padding-bottom:10px;padding-left:16px;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--_color---text--tertiary)}\n.ab_chart_panel-short{display:flex;align-items:center;grid-row-gap:8px;grid-column-gap:8px;color:var(--_color---text--primary);font-weight:500}\n.ab_chart_panel-body{padding-top:clamp(18px,2.4vw,28px);padding-right:clamp(18px,2.4vw,28px);padding-bottom:clamp(18px,2.4vw,28px);padding-left:clamp(18px,2.4vw,28px)}\n.ab_chart_title{font-weight:900;font-size:clamp(26px,2.5vw,40px);line-height:0.92;letter-spacing:-0.02em;text-transform:uppercase;overflow-wrap:anywhere}\n.ab_chart_title-a{display:block}\n.ab_chart_title-b{display:block}\n.ab_chart_sum{margin-top:16px;font-size:16px;color:var(--_color---text--secondary)}\n.ab_chart_plan{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);grid-row-gap:1px;grid-column-gap:1px;margin-top:18px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:var(--_color---neutral--hair)}\n.ab_chart_plan-item{padding-top:10px;padding-right:12px;padding-bottom:10px;padding-left:12px;background-color:var(--_color---neutral--deep)}\n.ab_chart_plan-no{font-size:11px;letter-spacing:0.06em;text-transform:uppercase;color:var(--_color---text--tertiary)}\n.ab_chart_plan-name{margin-top:2px;font-size:11px;font-weight:500;letter-spacing:0.06em;text-transform:uppercase;color:var(--_color---text--primary)}\n.ab_chart_actions{display:flex;flex-wrap:wrap;grid-row-gap:10px;grid-column-gap:10px;margin-top:20px}\n@media screen and (max-width: 991px) {\n.ab_chart_grid{grid-template-columns:minmax(0,1fr)}\n.ab_chart{max-width:560px}\n}\n@media screen and (max-width: 479px) {\n.ab_chart_plan{grid-template-columns:minmax(0,1fr)}\n}\n"
}