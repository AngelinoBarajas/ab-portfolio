[{"html": "<div class=\"ab_bento_cell\"><article class=\"ab_bento-card\" data-gm-card=\"\" data-selectable=\"\" data-name=\"Card / player-one\"><div class=\"ab_bento-card_viz is-gm\" data-gm=\"\" role=\"button\" tabindex=\"0\" aria-label=\"Earn XP\"><div class=\"ab_gm_row\"><span>Player one</span><span class=\"ab_gm_hearts\" data-gm-hearts=\"\" aria-hidden=\"true\"></span></div><div class=\"ab_gm_row\"><span class=\"ab_gm_lvl\" data-gm-lvl=\"\">LV 07</span><span data-gm-xpn=\"\">XP 000</span></div><div class=\"ab_gm_xp\"><div class=\"ab_gm_xp-fill\" data-gm-xp=\"\"></div></div><div class=\"ab_gm_press\">Press start</div></div><div class=\"ab_bento-card_copy\"><div class=\"ab_bento-card_label text-style-mono\">Gamer</div><h3 class=\"ab_bento-card_title\">Side quests</h3><p class=\"ab_bento-card_text\">Good games are a masterclass in onboarding, feedback and making people want to keep going.</p></div><div class=\"ab_off_hint\">Click to earn XP · know any cheat codes?</div></article></div>", "css": ".ab_bento-card_viz.is-gm{display:flex;flex-direction:column;justify-content:center;grid-row-gap:12px;grid-column-gap:12px;padding-top:18px;padding-right:20px;padding-bottom:18px;padding-left:20px;cursor:pointer;background-color:#0b0c14}\n.ab_gm_row{position:relative;display:flex;justify-content:space-between;align-items:baseline;font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:#F2F0EA}\n.ab_gm_hearts{display:flex;grid-row-gap:6px;grid-column-gap:6px}\n.ab_gm_lvl{font-weight:900;font-stretch:125%;font-size:34px;letter-spacing:0;color:#4cf2a0}\n.ab_gm_xp{position:relative;display:flex;height:14px;padding-top:2px;padding-right:2px;padding-bottom:2px;padding-left:2px;border-top-width:2px;border-top-style:solid;border-top-color:#F2F0EA;border-right-width:2px;border-right-style:solid;border-right-color:#F2F0EA;border-bottom-width:2px;border-bottom-style:solid;border-bottom-color:#F2F0EA;border-left-width:2px;border-left-style:solid;border-left-color:#F2F0EA}\n.ab_gm_xp-fill{width:0%;height:100%;background-image:repeating-linear-gradient(90deg,#4cf2a0 0 8px,#2fcf82 8px 10px)}\n.ab_gm_press{position:relative;font-size:11px;letter-spacing:0.14em;color:#ffd166}"}, {"html": "<div class=\"ab_bento_cell is-full\"><article class=\"ab_bento-card is-shelf\" data-selectable=\"\" data-name=\"Card / bookshelf\"><div class=\"ab_bento-card_copy\"><div class=\"ab_bento-card_label text-style-mono\">Book nerd</div><h3 class=\"ab_bento-card_title\">Always mid-book</h3><p class=\"ab_bento-card_text\">There is always one on the nightstand. Mostly sci-fi, philosophy and science, plus the bedtime stories that are now half the shelf.</p><div class=\"ab_off_hint is-shelf\">Knock a book off the shelf</div></div><div class=\"ab_shelf\" data-shelf=\"\"><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Sci-fi\" data-c=\"#1d2350\" data-h=\"190\" data-note=\"The genre that got me looking up.\"><span class=\"ab_book_label\">Sci-fi</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Philosophy\" data-c=\"#FF6A3D\" data-h=\"160\" data-fg=\"#07080D\" data-note=\"Where the “why” habit started.\"><span class=\"ab_book_label\">Philosophy</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Astrophysics\" data-c=\"#0B0C14\" data-h=\"205\" data-note=\"Dense. Worth it.\"><span class=\"ab_book_label\">Astrophysics</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Design\" data-c=\"#e0a45e\" data-h=\"150\" data-fg=\"#07080D\" data-note=\"Taking apart what I admire.\"><span class=\"ab_book_label\">Design</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Cosmos\" data-c=\"#3f4fa8\" data-h=\"180\" data-note=\"Re-read more than once.\"><span class=\"ab_book_label\">Cosmos</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Ethics\" data-c=\"#6b6f80\" data-h=\"140\" data-note=\"Why “do good” is in the mission statement.\"><span class=\"ab_book_label\">Ethics</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Sci-fi\" data-c=\"#7c5cff\" data-h=\"196\" data-note=\"The genre that got me looking up.\"><span class=\"ab_book_label\">Sci-fi</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Typography\" data-c=\"#F2F0EA\" data-h=\"168\" data-fg=\"#07080D\" data-note=\"Yes, I read books about letters.\"><span class=\"ab_book_label\">Typography</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Black holes\" data-c=\"#07080D\" data-h=\"210\" data-note=\"See also: the footer.\"><span class=\"ab_book_label\">Black holes</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Stoics\" data-c=\"#a44a1f\" data-h=\"150\" data-note=\"For launch weeks.\"><span class=\"ab_book_label\">Stoics</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Space opera\" data-c=\"#2f6b5a\" data-h=\"186\" data-note=\"Big ships, bigger ideas.\"><span class=\"ab_book_label\">Space opera</span></div><div class=\"ab_book is-lean\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Zarathustra\" data-c=\"#c2451a\" data-h=\"194\" data-note=\"Thus Spoke Zarathustra. On the nightstand right now, for another re-read.\"><span class=\"ab_book_label\">Zarathustra</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Physics\" data-c=\"#146EF5\" data-h=\"176\" data-note=\"Gravity is doing a lot of work on this site.\"><span class=\"ab_book_label\">Physics</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Game design\" data-c=\"#4cf2a0\" data-h=\"158\" data-fg=\"#07080D\" data-note=\"Onboarding lessons, disguised as fun.\"><span class=\"ab_book_label\">Game design</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Sci-fi\" data-c=\"#1b2a4a\" data-h=\"200\" data-note=\"The genre that got me looking up.\"><span class=\"ab_book_label\">Sci-fi</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Logic\" data-c=\"#c2412d\" data-h=\"146\" data-note=\"Old coursework. Still useful.\"><span class=\"ab_book_label\">Logic</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Exoplanets\" data-c=\"#3b1f12\" data-h=\"192\" data-note=\"Where every planet on this site comes from.\"><span class=\"ab_book_label\">Exoplanets</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Interfaces\" data-c=\"#9cc7ff\" data-h=\"170\" data-fg=\"#07080D\" data-note=\"Craft notes.\"><span class=\"ab_book_label\">Interfaces</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Time\" data-c=\"#161a2e\" data-h=\"184\" data-note=\"Mandatory reading after Interstellar.\"><span class=\"ab_book_label\">Time</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Epic fantasy\" data-c=\"#6b3fa0\" data-h=\"206\" data-note=\"The occasional detour.\"><span class=\"ab_book_label\">Epic fantasy</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Mind\" data-c=\"#e9d9ff\" data-h=\"152\" data-fg=\"#07080D\" data-note=\"How people think, so sites can make sense.\"><span class=\"ab_book_label\">Mind</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Rockets\" data-c=\"#ff8a4c\" data-h=\"174\" data-fg=\"#07080D\" data-note=\"Launch reference.\"><span class=\"ab_book_label\">Rockets</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Sci-fi\" data-c=\"#0f1b2d\" data-h=\"198\" data-note=\"The genre that got me looking up.\"><span class=\"ab_book_label\">Sci-fi</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Kid lit (shared)\" data-c=\"#ffd166\" data-h=\"138\" data-fg=\"#07080D\" data-note=\"Read aloud. Many, many times.\"><span class=\"ab_book_label\">Kid lit (shared)</span></div><div class=\"ab_book\" role=\"button\" tabindex=\"0\" data-book=\"\" data-g=\"Cosmology\" data-c=\"#2b1f5c\" data-h=\"188\" data-note=\"Where it all started, literally.\"><span class=\"ab_book_label\">Cosmology</span></div><div class=\"ab_shelf_floor\" aria-hidden=\"true\"></div><div class=\"ab_shelf_note\" data-shelf-note=\"\" role=\"status\"></div></div></article></div>", "css": ".ab_bento_cell.is-full{grid-column:1 / -1}\n.ab_bento-card.is-shelf{display:grid;grid-template-columns:minmax(0,0.8fr) minmax(0,2fr);align-items:stretch;grid-row-gap:24px;grid-column-gap:24px}\n.ab_off_hint.is-shelf{margin-top:14px}\n.ab_shelf{position:relative;display:flex;justify-content:center;align-items:flex-end;grid-row-gap:3px;grid-column-gap:3px;min-height:230px;padding-top:18px;padding-right:18px;padding-bottom:0;padding-left:18px;overflow-x:hidden;overflow-y:hidden;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-image:linear-gradient(180deg,#f7f5ef,#ece8de)}\n.ab_book{position:relative;display:flex;justify-content:center;align-items:center;flex-grow:0;flex-shrink:0;flex-basis:auto;width:28px;height:170px;margin-bottom:12px;cursor:pointer;background-color:#1d2350;color:#F2F0EA}\n.ab_book.is-lean{margin-left:12px}\n.ab_book_label{overflow-x:hidden;overflow-y:hidden;max-height:88%;font-size:9.5px;letter-spacing:0.12em;text-transform:uppercase;white-space:nowrap}\n.ab_shelf_floor{position:absolute;left:0;right:0;bottom:0;height:12px;background-color:#0B0C14}\n.ab_shelf_note{position:absolute;right:16px;top:14px;z-index:4;max-width:260px;padding-top:10px;padding-right:12px;padding-bottom:10px;padding-left:12px;background-color:#0B0C14;color:#F2F0EA;font-size:11.5px;line-height:1.45;opacity:0;pointer-events:none}\n@media screen and (max-width: 767px) {\n.ab_bento-card.is-shelf{grid-template-columns:minmax(0,1fr)}\n}\n@media screen and (max-width: 479px) {\n.ab_book{width:24px}\n}\n"}]