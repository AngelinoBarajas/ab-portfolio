{
 "html": "<section class=\"section_sm-chart\" id=\"chart\" data-frame=\"sectors\" aria-label=\"Site map\"><span class=\"ab_frame-label\" data-frame-label=\"\" aria-hidden=\"true\">▢ sectors</span><div class=\"padding-global\"><div class=\"container-large\"><div class=\"ab_sm-grid\"><div class=\"ab_sm-sector\" id=\"sector-routes\"><div class=\"ab_sm-sector_head text-style-mono\"><span class=\"ab_sm-sector_no\">Sector 01</span><span class=\"ab_sm-sector_path\">/</span></div><div class=\"ab_sm-sector_title\"><div class=\"ab_planet is-sm\" data-planet=\"rocky\" data-colors=\"#6b6258,#9a8c7a,#433c35\" data-spin=\"60\" aria-hidden=\"true\"></div><h2 class=\"ab_sm-sector_h\">Main <span class=\"t-outline\">routes</span></h2></div><p class=\"ab_sm-sector_p\">The pages the nav and the footer point to.</p><div class=\"ab_sm-list\"><a class=\"ab_sm-link\" href=\"/\"><span class=\"ab_sm-dot\" aria-hidden=\"true\"></span><span class=\"ab_sm-link_n\">Home</span><span class=\"ab_sm-link_p\">Start here</span></a><a class=\"ab_sm-link\" href=\"/work\"><span class=\"ab_sm-dot\" aria-hidden=\"true\"></span><span class=\"ab_sm-link_n\">Work</span><span class=\"ab_sm-link_p\">The mission archive</span></a><a class=\"ab_sm-link\" href=\"/services\"><span class=\"ab_sm-dot\" aria-hidden=\"true\"></span><span class=\"ab_sm-link_n\">Services</span><span class=\"ab_sm-link_p\">Launch control</span></a><a class=\"ab_sm-link\" href=\"/process\"><span class=\"ab_sm-dot\" aria-hidden=\"true\"></span><span class=\"ab_sm-link_n\">Process</span><span class=\"ab_sm-link_p\">The flight plan</span></a><a class=\"ab_sm-link\" href=\"/about\"><span class=\"ab_sm-dot\" aria-hidden=\"true\"></span><span class=\"ab_sm-link_n\">About</span><span class=\"ab_sm-link_p\">Meet the pilot</span></a><a class=\"ab_sm-link\" href=\"/observatory\"><span class=\"ab_sm-dot\" aria-hidden=\"true\"></span><span class=\"ab_sm-link_n\">Observatory</span><span class=\"ab_sm-link_p\">Field notes</span></a><a class=\"ab_sm-link\" href=\"/topics\"><span class=\"ab_sm-dot\" aria-hidden=\"true\"></span><span class=\"ab_sm-link_n\">Topics</span><span class=\"ab_sm-link_p\">The star chart</span></a><a class=\"ab_sm-link\" href=\"/contact\"><span class=\"ab_sm-dot\" aria-hidden=\"true\"></span><span class=\"ab_sm-link_n\">Contact</span><span class=\"ab_sm-link_p\">Open a channel</span></a></div></div><div class=\"ab_sm-sector\" id=\"sector-missions\"><div class=\"ab_sm-sector_head text-style-mono\"><span class=\"ab_sm-sector_no\">Sector 02</span><span class=\"ab_sm-sector_path\">/work</span></div><div class=\"ab_sm-sector_title\"><div class=\"ab_planet is-sm\" data-planet=\"gas\" data-colors=\"#3b1f12,#a44a1f,#ff8a4c,#ffd29a,#6b2b16\" data-spin=\"60\" aria-hidden=\"true\" data-ring=\"#ffd29a,#ff6a3d,#6b2b16\" data-tilt=\"-18\"></div><h2 class=\"ab_sm-sector_h\">Mission <span class=\"t-outline\">debriefs</span></h2></div><p class=\"ab_sm-sector_p\">Every launch: what I built, how, and why.</p><div class=\"ab_sm-list\"><div class=\"ab_sm-host\" data-sm-list=\"missions\"></div></div><a class=\"ab_sm-all text-style-mono\" href=\"/work\">Open the archive →</a></div><div class=\"ab_sm-sector is-wide\" id=\"sector-services\"><div class=\"ab_sm-sector_head text-style-mono\"><span class=\"ab_sm-sector_no\">Sector 03</span><span class=\"ab_sm-sector_path\">/services</span></div><div class=\"ab_sm-sector_title\"><div class=\"ab_planet is-sm\" data-planet=\"ice\" data-colors=\"#0f2a3a,#3f8fa8,#9fe8ff,#eaffff\" data-spin=\"60\" aria-hidden=\"true\"></div><h2 class=\"ab_sm-sector_h\">Services</h2></div><p class=\"ab_sm-sector_p\">Eight services, one pilot.</p><div class=\"ab_sm-list is-cols\"><div class=\"ab_sm-host\" data-sm-list=\"services\"></div></div><a class=\"ab_sm-all text-style-mono\" href=\"/services\">Open launch control →</a></div><div class=\"ab_sm-sector is-wide\" id=\"sector-notes\"><div class=\"ab_sm-sector_head text-style-mono\"><span class=\"ab_sm-sector_no\">Sector 04</span><span class=\"ab_sm-sector_path\">/observatory</span></div><div class=\"ab_sm-sector_title\"><div class=\"ab_planet is-sm\" data-planet=\"gas\" data-colors=\"#1d2350,#3f4fa8,#8fb1ff,#e9d9ff,#2b1f5c\" data-spin=\"60\" aria-hidden=\"true\"></div><h2 class=\"ab_sm-sector_h\">Field <span class=\"t-outline\">notes</span></h2></div><p class=\"ab_sm-sector_p\">Build notes and why-before-how essays from the Observatory, newest first.</p><div class=\"ab_sm-list is-cols\"><div class=\"ab_sm-host\" data-sm-list=\"notes\"></div></div><a class=\"ab_sm-all text-style-mono\" href=\"/observatory\">Open the Observatory →</a></div><div class=\"ab_sm-sector is-wide\" id=\"sector-topics\"><div class=\"ab_sm-sector_head text-style-mono\"><span class=\"ab_sm-sector_no\">Sector 05</span><span class=\"ab_sm-sector_path\">/topics</span></div><div class=\"ab_sm-sector_title\"><div class=\"ab_planet is-sm\" data-planet=\"terra\" data-colors=\"#0e3a5c,#1e6e8c,#3f8f4a,#a88b5c,#f2f0ea\" data-spin=\"60\" aria-hidden=\"true\"></div><h2 class=\"ab_sm-sector_h\">Topics</h2></div><p class=\"ab_sm-sector_p\">The shared vocabulary. Every word is a page that links the notes, missions and services behind it.</p><div class=\"ab_sm-list is-cols\"><div class=\"ab_sm-host\" data-sm-list=\"topics\"></div></div><a class=\"ab_sm-all text-style-mono\" href=\"/topics\">Open the star chart →</a></div></div></div></div></section>",
 "css": ".section_sm-chart{position:relative;padding-top:clamp(24px,3vw,40px);padding-bottom:clamp(64px,8vw,120px)}\n.ab_sm-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-row-gap:1px;grid-column-gap:1px;border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair);border-right-width:1px;border-right-style:solid;border-right-color:var(--_color---neutral--hair);border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);border-left-width:1px;border-left-style:solid;border-left-color:var(--_color---neutral--hair);background-color:var(--_color---neutral--hair)}\n.ab_sm-sector{position:relative;display:flex;flex-direction:column;grid-row-gap:14px;grid-column-gap:14px;padding-top:clamp(20px,2.4vw,34px);padding-right:clamp(20px,2.4vw,34px);padding-bottom:clamp(20px,2.4vw,34px);padding-left:clamp(20px,2.4vw,34px);background-color:var(--_color---neutral--deep)}\n.ab_sm-sector.is-wide{grid-column-start:1;grid-column-end:-1}\n.ab_sm-sector_head{display:flex;justify-content:space-between;grid-row-gap:12px;grid-column-gap:12px;font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;color:var(--_color---text--tertiary)}\n.ab_sm-sector_no{color:var(--_color---brand--signal)}\n.ab_sm-sector_path{color:var(--_color---text--tertiary)}\n.ab_sm-sector_title{display:flex;align-items:center;grid-row-gap:14px;grid-column-gap:14px}\n.ab_planet.is-sm{position:relative;top:auto;left:auto;right:auto;bottom:auto;flex-grow:0;flex-shrink:0;flex-basis:auto;width:34px;height:34px}\n.ab_sm-sector_h{font-weight:900;font-size:clamp(26px,2.6vw,40px);line-height:1;text-transform:uppercase}\n.ab_sm-sector_p{max-width:56ch;font-size:15px;color:var(--_color---text--secondary)}\n.ab_sm-list{display:grid;grid-template-columns:minmax(0,1fr);border-top-width:1px;border-top-style:solid;border-top-color:var(--_color---neutral--hair)}\n.ab_sm-list.is-cols{grid-template-columns:repeat(auto-fill,minmax(280px,1fr));grid-column-gap:28px}\n.ab_sm-host{display:contents}\n.ab_sm-items{display:contents}\n.ab_sm-item{display:contents}\n.ab_sm-link{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:baseline;grid-column-gap:10px;padding-top:10px;padding-bottom:10px;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:var(--_color---neutral--hair);color:var(--_color---text--primary);text-decoration:none}\n.ab_sm-dot{width:6px;height:6px;border-top-left-radius:50%;border-top-right-radius:50%;border-bottom-right-radius:50%;border-bottom-left-radius:50%;background-color:var(--_color---brand--signal);transform:translateY(-2px)}\n.ab_sm-link_n{font-size:16px;line-height:1.3;color:var(--_color---text--primary)}\n.ab_sm-link_p{font-size:11px;letter-spacing:0.04em;color:var(--_color---text--tertiary);text-align:right}\n.ab_sm-all{align-self:flex-start;margin-top:auto;padding-top:6px;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--_color---brand--signal);text-decoration:none}\n@media screen and (max-width: 767px) {\n.ab_sm-grid{grid-template-columns:minmax(0,1fr)}\n.ab_sm-list.is-cols{grid-template-columns:minmax(0,1fr)}\n.ab_sm-link{grid-template-columns:auto minmax(0,1fr)}\n.ab_sm-link_p{display:none}\n}\n"
}