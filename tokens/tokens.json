{
  "$meta": {
    "source": "Prototype CSS (:root and .theme-light) across all six AB Portfolio prototypes",
    "target": "Webflow Variables (Client-First naming). Create collections in this order: Color (with modes), Typography, Size, Spacing.",
    "note": "Webflow variables accept px/rem/em/vw/% and clamp() via the custom value field. Where clamp() is not accepted in a given field, use the 'fallback' value and apply the fluid size with a class-level custom property."
  },
  "collections": [
    {
      "name": "Color",
      "modes": [
        "Dark (base)",
        "Light"
      ],
      "note": "Dark is the base mode for the whole site. Apply the Light mode to .theme-light sections (bento, manifest, off-duty, what's included).",
      "variables": [
        {
          "name": "Neutral / Void",
          "css": "--void",
          "Dark (base)": "#07080D",
          "Light": "#F2F0EA",
          "use": "Page background"
        },
        {
          "name": "Neutral / Deep",
          "css": "--deep",
          "Dark (base)": "#0E1020",
          "Light": "#FBFAF6",
          "use": "Card background"
        },
        {
          "name": "Neutral / Panel",
          "css": "--panel",
          "Dark (base)": "#161A2E",
          "Light": "#FFFFFF",
          "use": "Raised card, hover state"
        },
        {
          "name": "Neutral / Hair",
          "css": "--hair",
          "Dark (base)": "rgba(255,255,255,0.10)",
          "Light": "rgba(11,12,20,0.12)",
          "use": "Hairline borders"
        },
        {
          "name": "Neutral / Hair Strong",
          "css": "--hair2",
          "Dark (base)": "rgba(255,255,255,0.22)",
          "Light": "rgba(11,12,20,0.28)",
          "use": "Chips, stronger borders"
        },
        {
          "name": "Neutral / Glass",
          "css": "--glass",
          "Dark (base)": "rgba(14,16,32,0.78)",
          "Light": "rgba(251,250,246,0.78)",
          "use": "Translucent nav bar, feed console (added during the Webflow build)"
        },
        {
          "name": "Text / Primary",
          "css": "--star",
          "Dark (base)": "#F2F0EA",
          "Light": "#0B0C14",
          "use": "Headings, body on dark"
        },
        {
          "name": "Text / Secondary",
          "css": "--soft",
          "Dark (base)": "#C9C7C0",
          "Light": "#3B3E4B",
          "use": "Paragraphs, ledes"
        },
        {
          "name": "Text / Tertiary",
          "css": "--dust",
          "Dark (base)": "#8A8FA3",
          "Light": "#6B6F80",
          "use": "Mono labels, meta"
        },
        {
          "name": "Brand / Signal",
          "css": "--signal",
          "Dark (base)": "#FF6A3D",
          "Light": "#FF6A3D",
          "use": "Accent, primary button, active states"
        },
        {
          "name": "Brand / On Signal",
          "css": "--on-signal",
          "Dark (base)": "#07080D",
          "Light": "#07080D",
          "use": "Text on orange"
        },
        {
          "name": "UI / Select",
          "css": "--select",
          "Dark (base)": "#4C8DFF",
          "Light": "#2F6BFF",
          "use": "Figma-style selection boxes, focus ring"
        },
        {
          "name": "Brand / Nebula",
          "css": "--nebula",
          "Dark (base)": "#7C5CFF",
          "Light": "#7C5CFF",
          "use": "Background glows"
        },
        {
          "name": "Status / Live",
          "css": "--live",
          "Dark (base)": "#3BE38A",
          "Light": "#1FA463",
          "use": "Live / available dots"
        },
        {
          "name": "Status / Alert",
          "css": "--alert",
          "Dark (base)": "#FF5A5A",
          "Light": "#D93636",
          "use": "404, errors"
        }
      ]
    },
    {
      "name": "Typography",
      "variables": [
        {
          "name": "Font / Display",
          "value": "Archivo",
          "weights": "400-900, width axis 62-125",
          "use": "Headings, set font-stretch 108-125%"
        },
        {
          "name": "Font / Body",
          "value": "Geist",
          "weights": "400, 500, 600"
        },
        {
          "name": "Font / Mono",
          "value": "JetBrains Mono",
          "weights": "400, 500",
          "use": "Eyebrows, labels, code, HUD"
        },
        {
          "name": "Font / Script",
          "value": "Caveat",
          "weights": "600",
          "use": "Signature on About only"
        }
      ]
    },
    {
      "name": "Size",
      "note": "Type scale. Values are clamp() so they scale fluidly; fallback is the desktop max.",
      "variables": [
        {
          "name": "Heading / Display",
          "value": "clamp(46px, 11.2vw, 190px)",
          "fallback": "190px",
          "class": "heading-style-display",
          "extra": "weight 900, stretch 112%, line-height .86, tracking -0.03em, uppercase"
        },
        {
          "name": "Heading / H1",
          "value": "clamp(52px, 10.5vw, 180px)",
          "fallback": "180px",
          "class": "heading-style-h1",
          "extra": "weight 900, stretch 118%, line-height .86, tracking -0.03em, uppercase. Template heroes auto-fit the longest word with JS."
        },
        {
          "name": "Heading / H2",
          "value": "clamp(40px, 6.4vw, 92px)",
          "fallback": "92px",
          "class": "heading-style-h2",
          "extra": "weight 900, stretch 118%, line-height .92, tracking -0.02em, uppercase"
        },
        {
          "name": "Heading / Statement",
          "value": "clamp(34px, 5.4vw, 78px)",
          "fallback": "78px",
          "class": "heading-style-statement",
          "extra": "weight 800, stretch 108%, line-height 1"
        },
        {
          "name": "Heading / H3",
          "value": "clamp(20px, 1.7vw, 24px)",
          "fallback": "24px",
          "class": "heading-style-h3",
          "extra": "weight 800, stretch 112%, line-height 1.05, uppercase"
        },
        {
          "name": "Text / Lede",
          "value": "clamp(17px, 1.5vw, 20px)",
          "fallback": "20px",
          "class": "text-size-lede"
        },
        {
          "name": "Text / Body",
          "value": "17px",
          "class": "text-size-regular",
          "extra": "line-height 1.6"
        },
        {
          "name": "Text / Small",
          "value": "15px",
          "class": "text-size-small"
        },
        {
          "name": "Text / Eyebrow",
          "value": "12px",
          "class": "text-style-eyebrow",
          "extra": "mono, tracking 0.1em, uppercase, Text / Tertiary"
        },
        {
          "name": "Text / Micro",
          "value": "10.5px",
          "class": "text-size-micro",
          "extra": "mono labels, frame labels"
        }
      ]
    },
    {
      "name": "Spacing",
      "variables": [
        {
          "name": "Layout / Gutter",
          "value": "clamp(16px, 4vw, 48px)",
          "fallback": "48px",
          "use": "padding-global left/right"
        },
        {
          "name": "Layout / Max Width",
          "value": "1360px",
          "use": "container-large"
        },
        {
          "name": "Section / Padding",
          "value": "clamp(64px, 9vw, 120px)",
          "fallback": "120px",
          "use": "padding-section-medium"
        },
        {
          "name": "Section / Padding Large",
          "value": "clamp(120px, 14vw, 170px)",
          "fallback": "170px",
          "use": "hero top padding (clears the fixed nav)"
        },
        {
          "name": "Grid / Gap",
          "value": "16px",
          "use": "bento gap"
        },
        {
          "name": "Grid / Gap Large",
          "value": "20px",
          "use": "card grids"
        },
        {
          "name": "Grid / Column Gap",
          "value": "24px",
          "use": "12-column layout grid overlay"
        },
        {
          "name": "Button / Height",
          "value": "56px"
        },
        {
          "name": "Radius / None",
          "value": "0px",
          "use": "The system is square-first. No rounded corners except planets and dots."
        }
      ]
    }
  ],
  "motion": {
    "ease-out": "cubic-bezier(.2,.9,.2,1)",
    "ease-spring": "cubic-bezier(.2,.9,.2,1.4)",
    "ease-inout": "cubic-bezier(.7,0,.2,1)",
    "gsap": "expo.out for reveals, elastic.out(1,.5) for springs",
    "reduced-motion": "Every effect must have a prefers-reduced-motion fallback"
  }
}
